@model OrderModel
@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as CartViewModel;
}

<div class="container py-5">
    <!-- Step Progress Header -->
    <div class="d-flex align-items-center justify-content-center gap-2 gap-md-3 mb-5">
        <span class="checkout-step-pill"><i class="bi bi-bag me-1"></i> 1. Bag Review</span>
        <span class="text-muted small">&rarr;</span>
        <span class="checkout-step-pill active"><i class="bi bi-truck me-1"></i> 2. Delivery & Payment</span>
        <span class="text-muted small">&rarr;</span>
        <span class="checkout-step-pill"><i class="bi bi-check-circle me-1"></i> 3. Roaster Confirmation</span>
    </div>

    <div class="row g-5">
        <!-- Customer & Delivery Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="brand-font fw-bold mb-4">Shipping & Delivery Information</h3>

                <form asp-action="PlaceOrder" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-12">
                            <label asp-for="CustomerName" class="form-label small fw-semibold text-muted">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person"></i></span>
                                <input asp-for="CustomerName" class="form-control border-start-0 ps-0" placeholder="e.g. Seth Andrey" />
                            </div>
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="seth@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold text-muted">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="+1 (555) 019-2834" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- Street Address -->
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-muted">Street Delivery Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control border-start-0 ps-0" placeholder="123 Specialty Roasters Ave, Suite 4" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-semibold text-muted">City</label>
                            <input asp-for="City" class="form-control" placeholder="Seattle" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <!-- Postal Code -->
                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label small fw-semibold text-muted">Postal / ZIP Code</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="98101" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>

                        <!-- Payment Method Section -->
                        <div class="col-12 mt-4">
                            <h5 class="brand-font fw-bold mb-3">Select Payment Method</h5>

                            <div class="d-flex flex-column gap-2">
                                <!-- Option 1: Credit Card -->
                                <label class="payment-method-card d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="CreditCard" id="payCC" checked />
                                        <div>
                                            <div class="fw-semibold text-dark">Credit or Debit Card</div>
                                            <div class="text-muted small" style="font-size: 0.76rem;">Secure instant payment via Stripe/Vault</div>
                                        </div>
                                    </div>
                                    <div class="text-secondary fs-5 d-flex gap-2">
                                        <i class="bi bi-credit-card-2-front"></i>
                                    </div>
                                </label>

                                <!-- Option 2: Digital Wallet -->
                                <label class="payment-method-card d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="DigitalWallet" id="payWallet" />
                                        <div>
                                            <div class="fw-semibold text-dark">Apple Pay / Google Pay</div>
                                            <div class="text-muted small" style="font-size: 0.76rem;">Fast 1-touch checkout with biometric verification</div>
                                        </div>
                                    </div>
                                    <div class="text-dark fs-5 d-flex gap-2">
                                        <i class="bi bi-apple"></i>
                                        <i class="bi bi-google"></i>
                                    </div>
                                </label>

                                <!-- Option 3: Roastery Pickup -->
                                <label class="payment-method-card d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="CashOnPickup" id="payCash" />
                                        <div>
                                            <div class="fw-semibold text-dark">Roastery Bar Pickup & Pay</div>
                                            <div class="text-muted small" style="font-size: 0.76rem;">Pay upon collection at 104 Artisanal Way</div>
                                        </div>
                                    </div>
                                    <div class="text-success fs-5">
                                        <i class="bi bi-shop"></i>
                                    </div>
                                </label>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>

                        <!-- Special Instructions -->
                        <div class="col-12 mt-3">
                            <label asp-for="OrderNotes" class="form-label small fw-semibold text-muted">Special Roasting or Delivery Notes (Optional)</label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="2" 
                                      placeholder="e.g. Please grind for Hario V60, or leave package inside the porch gate."></textarea>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn-coffee-primary w-100 py-3 text-white fs-6 shadow">
                                <i class="bi bi-lock-fill me-2"></i> Authorize & Place Coffee Order
                            </button>
                            <div class="text-center text-muted small mt-2">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                Your transaction is secure with end-to-end 256-bit encryption.
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sticky Order Summary Column -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
                <h4 class="brand-font fw-bold mb-3">Order Review</h4>

                @if (cart != null)
                {
                    <div class="mb-3 pe-1" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3" style="width: 52px; height: 52px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-semibold small text-dark">@item.ProductName</div>
                                        <div class="text-muted small" style="font-size: 0.78rem;">Qty: @item.Quantity &times; @item.Price.ToString("C")</div>
                                    </div>
                                </div>
                                <div class="fw-bold text-dark small">
                                    @item.TotalPrice.ToString("C")
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold">@cart.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Estimated Tax (8%)</span>
                        <span class="fw-semibold">@cart.EstimatedTax.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Specialty Delivery</span>
                        @if (cart.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@cart.ShippingFee.ToString("C")</span>
                        }
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5 mb-4">
                        <span class="fw-bold text-dark">Total Due</span>
                        <span class="fw-bold text-dark">@cart.GrandTotal.ToString("C")</span>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 small text-muted">
                    <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-semibold">
                        <i class="bi bi-fire text-warning"></i> Fresh Batch Promise
                    </div>
                    Beans are micro-roasted and degassed before delivery to ensure optimal crema and peak aroma.
                </div>
            </div>
        </div>
    </div>
</div>
