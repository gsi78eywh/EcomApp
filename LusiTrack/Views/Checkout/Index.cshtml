@using LusiTrack.Services
@model OrderModel
@{
    ViewData["Title"] = "Order & Reservation | JMT CAFE Dalaguete";
    var cart = ViewBag.Cart as CartViewModel;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-muted text-decoration-none">Cart</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Checkout</li>
        </ol>
    </nav>

    <!-- 5-Step Checkout Stepper (60-30-10 Design System) -->
    <div class="checkout-stepper mb-5">
        <div class="checkout-step-node completed">
            <div class="step-node-circle"><i class="bi bi-check-lg"></i></div>
            <div class="step-node-label">01 Cart</div>
        </div>
        <div class="checkout-step-node active">
            <div class="step-node-circle">2</div>
            <div class="step-node-label">02 Contact</div>
        </div>
        <div class="checkout-step-node active">
            <div class="step-node-circle">3</div>
            <div class="step-node-label">03 Delivery</div>
        </div>
        <div class="checkout-step-node active">
            <div class="step-node-circle">4</div>
            <div class="step-node-label">04 Payment</div>
        </div>
        <div class="checkout-step-node">
            <div class="step-node-circle">5</div>
            <div class="step-node-label">05 Receipt</div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Customer & Delivery Form Column (60% Dominant Canvas Surface) -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white" style="border: 1px solid rgba(41, 24, 14, 0.08);">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <span class="badge badge-espresso rounded-pill px-3 py-1 small mb-1">
                            <i class="bi bi-shield-check text-warning me-1"></i> Fast Guest Checkout
                        </span>
                        <h3 class="brand-font fw-bold mb-0 text-dark">Customer & Delivery Details</h3>
                    </div>
                    <span class="badge badge-verified rounded-pill px-3 py-1 small">
                        <i class="bi bi-patch-check-fill me-1"></i> Verified
                    </span>
                </div>

                <form asp-action="PlaceOrder" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CustomerName" class="form-label small fw-bold text-secondary">Full Name</label>
                            <input asp-for="CustomerName" class="form-control form-control-lg rounded-3" placeholder="e.g. Maria Santos" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold text-secondary">Email Address (Order Confirmation)</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="maria@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-bold text-secondary">Mobile Number (Courier SMS Dispatch)</label>
                            <input asp-for="Phone" class="form-control rounded-3" placeholder="0917 123 4567" required />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- Fulfillment Option Selector (60-30-10 Interactive Options) -->
                        <div class="col-12 mt-3">
                            <label class="form-label small fw-bold text-secondary mb-2">Fulfillment Mode</label>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="payment-card-option w-100">
                                        <input class="form-check-input mt-0" type="radio" asp-for="FulfillmentType" value="Delivery" id="fulDelivery" checked onchange="toggleAddressSection(true)" />
                                        <div>
                                            <div class="fw-bold text-dark"><i class="bi bi-truck text-warning me-1"></i> Dalaguete Local Delivery</div>
                                            <small class="text-muted d-block mt-1">Direct to your home or stopover (₱50 near shop • ₱150 Lungsod)</small>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-sm-6">
                                    <label class="payment-card-option w-100">
                                        <input class="form-check-input mt-0" type="radio" asp-for="FulfillmentType" value="Pickup" id="fulPickup" onchange="toggleAddressSection(false)" />
                                        <div>
                                            <div class="fw-bold text-dark"><i class="bi bi-shop text-warning me-1"></i> JMT Cafe Onsite Pickup</div>
                                            <small class="text-muted d-block mt-1">Pick up free at Purok 5 Tabon, Dalaguete</small>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Delivery Address Fields -->
                        <div class="col-12" id="addressContainer">
                            <label asp-for="Address" class="form-label small fw-bold text-secondary">Delivery Address (Sitio, Landmark, Barangay)</label>
                            <input asp-for="Address" class="form-control rounded-3" placeholder="Purok 5 Tabon, Dalaguete, near Basketball Court" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="cityContainer">
                            <label asp-for="City" class="form-label small fw-bold text-secondary">City / Municipality</label>
                            <select asp-for="City" class="form-select rounded-3">
                                <option value="Dalaguete">Dalaguete</option>
                                <option value="Argao">Argao</option>
                                <option value="Alcoy">Alcoy</option>
                                <option value="Cebu City">Cebu City (Advance Order)</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="postalContainer">
                            <label asp-for="PostalCode" class="form-label small fw-bold text-secondary">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control rounded-3" placeholder="6022" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>

                        <!-- Exclusive GCash Payment Portal (30% Espresso Structure, 10% Gold Accent) -->
                        <div class="col-12 mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="brand-font fw-bold mb-0 text-dark">Payment Method</h4>
                                <span class="badge badge-gold px-3 py-1 rounded-pill">
                                    <i class="bi bi-shield-check me-1"></i> 100% Pre-Paid via GCash
                                </span>
                            </div>

                            <!-- Zero-RTS / No-COD Security Notice in Warm Neutral -->
                            <div class="p-3 rounded-4 mb-3 d-flex align-items-start gap-3" 
                                 style="background: #FFFDF9; border: 1px solid rgba(212, 163, 115, 0.35);">
                                <i class="bi bi-shield-lock-fill text-warning fs-4 mt-1 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-dark d-block mb-1">Guaranteed Fresh Preparation & Priority Dispatch</strong>
                                    <small class="text-secondary" style="line-height: 1.6;">
                                        All party burgers, chicken meals, fruit shakes, and artisan drinks are prepared fresh to order at JMT CAFE in Purok 5 Tabon, Dalaguete. We accept GCash pre-payments and verified onsite orders.
                                    </small>
                                </div>
                            </div>

                            <!-- Hidden field ensuring GCash is always set -->
                            <input type="hidden" asp-for="PaymentMethod" value="GCash" />

                            <!-- GCash Official Merchant Portal Card -->
                            <div class="gcash-portal-card mb-2">
                                <div class="gcash-portal-header">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" 
                                             style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--gold-400), var(--gold-600)); color: var(--coffee-950);">
                                            <i class="bi bi-wallet2 fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold mb-0 text-white">GCash Official Merchant</div>
                                            <small class="text-warning opacity-90" style="font-size: 0.75rem;">JMT CAFE Dalaguete • Official Food & Drinks Hub</small>
                                        </div>
                                    </div>
                                    <span class="badge badge-verified px-3 py-1 rounded-pill">
                                        <i class="bi bi-patch-check-fill text-success me-1"></i> Verified Merchant
                                    </span>
                                </div>

                                <div class="p-4 bg-white">
                                    <div class="row g-4 align-items-center">
                                        <!-- GCash Merchant Details -->
                                        <div class="col-md-7">
                                            <div class="mb-3">
                                                <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Send Payment To Account:</span>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="fs-4 fw-bold text-dark font-monospace">@JmtCafeConfig.PhoneDisplay</span>
                                                    <button type="button" id="copyMerchantBtn" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold" onclick="copyMerchantNumber(this)">
                                                        <i class="bi bi-clipboard me-1"></i> Copy
                                                    </button>
                                                </div>
                                                <small class="text-muted">Account Name: <strong class="text-dark">JMT CAFE</strong></small>
                                            </div>

                                            <div class="mb-3">
                                                <label asp-for="GCashReferenceNumber" class="form-label small fw-bold text-secondary">
                                                    GCash Transaction Reference Number
                                                </label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-receipt"></i></span>
                                                    <input asp-for="GCashReferenceNumber" class="form-control font-monospace border-start-0" placeholder="e.g. 98328104821" required />
                                                </div>
                                                <small class="text-muted d-block mt-1">
                                                    Pre-filled with your session token. You may update this with the 13-digit Reference No. from your GCash SMS or receipt.
                                                </small>
                                                <span asp-validation-for="GCashReferenceNumber" class="text-danger small"></span>
                                            </div>
                                        </div>

                                        <!-- QR Code Scan Box -->
                                        <div class="col-md-5 text-center">
                                            <div class="p-3 gcash-qr-box d-inline-block shadow-sm">
                                                <div class="p-2 rounded-3 mb-2 d-flex flex-column align-items-center justify-content-center" 
                                                     style="width: 140px; height: 140px; margin: 0 auto; background: #FFFDF9;">
                                                    <i class="bi bi-qr-code text-dark" style="font-size: 4rem;"></i>
                                                    <div class="small fw-bold text-warning" style="font-size: 0.65rem; letter-spacing: 0.05em;">SCAN TO PAY</div>
                                                </div>
                                                <small class="text-secondary d-block fw-semibold" style="font-size: 0.75rem;">
                                                    Scan with GCash App
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Courier / Barista Notes -->
                        <div class="col-12 mt-3">
                            <label asp-for="OrderNotes" class="form-label small fw-bold text-secondary">Special Instructions or Landmark (Optional)</label>
                            <textarea asp-for="OrderNotes" class="form-control rounded-3" rows="2" placeholder="e.g. Please ring doorbell at the front gate; grind beans for French press..."></textarea>
                        </div>

                        <!-- 10% Accent CTA Button -->
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-gold btn-lg w-100 py-3 fw-bold shadow">
                                <i class="bi bi-shield-lock-fill me-2"></i> Confirm Order & Dispatch
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sticky Order Receipt Column (30% Structure / Summary) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 bg-white sticky-top" style="top: 90px; border: 1px solid rgba(41, 24, 14, 0.08);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="brand-font fw-bold mb-0 text-dark">Order Summary</h4>
                    <span class="badge badge-espresso rounded-pill px-3 py-1">@cart?.TotalItemsCount item@(cart?.TotalItemsCount > 1 ? "s" : "")</span>
                </div>

                @if (cart != null)
                {
                    <div class="mb-3" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3 shadow-xs" style="width: 52px; height: 52px; object-fit: cover; border: 1px solid rgba(41, 24, 14, 0.1);" />
                                    <div>
                                        <div class="fw-bold text-dark small">@item.ProductName</div>
                                        <div class="text-muted small">
                                            @item.Quantity &times; ₱@item.Price.ToString("N2")
                                            @if (!string.IsNullOrEmpty(item.VariantSummary))
                                            {
                                                <span class="text-secondary">(@item.VariantSummary)</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="fw-bold text-dark small">
                                    ₱@item.TotalPrice.ToString("N2")
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold">₱@cart.Subtotal.ToString("N2")</span>
                    </div>

                    @if (cart.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Promo Discount (@cart.CouponCode)</span>
                            <span class="fw-bold">-₱@cart.DiscountAmount.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Local VAT (5%)</span>
                        <span class="fw-semibold">₱@cart.EstimatedTax.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Fulfillment</span>
                        @if (cart.ShippingFee == 0 || cart.IsPickup)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span class="fw-semibold">₱@cart.ShippingFee.ToString("N2")</span>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5 text-dark">Total Due</span>
                        <span class="fw-bold fs-3 text-warning font-monospace" style="color: #b86e08 !important;">₱@cart.GrandTotal.ToString("N2")</span>
                    </div>
                }

                <div class="p-3 rounded-4 small text-secondary" style="background: #FFFDF9; border: 1px solid rgba(212, 163, 115, 0.25);">
                    <div class="d-flex gap-2 align-items-start">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <div>
                            <strong class="text-dark">Guaranteed Freshness & No RTS</strong>
                            <p class="mb-0 mt-1" style="line-height: 1.5;">
                                Dishes, burgers, and beverages are prepared fresh to order at JMT CAFE in Purok 5 Tabon, Dalaguete. Pre-paid GCash guarantees immediate priority queueing.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleAddressSection(isDelivery) {
            const addr = document.getElementById('addressContainer');
            const city = document.getElementById('cityContainer');
            const postal = document.getElementById('postalContainer');
            if (addr && city && postal) {
                if (isDelivery) {
                    addr.style.display = 'block';
                    city.style.display = 'block';
                    postal.style.display = 'block';
                } else {
                    addr.style.display = 'none';
                    city.style.display = 'none';
                    postal.style.display = 'none';
                }
            }
        }

        function copyMerchantNumber(btn) {
            const phone = '@JmtCafeConfig.PhoneDisplay';
            navigator.clipboard.writeText(phone).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2 me-1"></i> Copied!';
                btn.classList.replace('btn-outline-dark', 'btn-success');
                if (window.showToast) {
                    window.showToast("GCash Number Copied", phone + " copied to clipboard.");
                }
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.replace('btn-success', 'btn-outline-dark');
                }, 2000);
            });
        }
    </script>
}
