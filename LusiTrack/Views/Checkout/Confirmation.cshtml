@{
    ViewData["Title"] = "Order Confirmation";
    var orderId = ViewBag.OrderId as string ?? "LUSI-ORDER";
    var customerName = ViewBag.CustomerName as string ?? "Coffee Enthusiast";
    var totalPaid = ViewBag.TotalPaid as string ?? "$0.00";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle" style="width: 80px; height: 80px;">
                        <i class="bi bi-check2-circle display-4"></i>
                    </div>
                </div>

                <h1 class="brand-font fw-bold mb-2">Thank You, @customerName!</h1>
                <p class="lead text-muted mb-4">Your coffee order has been placed successfully and is being prepared.</p>

                <div class="p-4 bg-light rounded-4 mb-4 text-start">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small">Tracking Order ID</span>
                            <div class="fw-bold fs-5 text-dark">@orderId</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Total Paid</span>
                            <div class="fw-bold fs-5 text-success">@totalPaid</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Estimated Delivery</span>
                            <div class="fw-semibold">Within 24-48 Hours</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Status</span>
                            <div><span class="badge bg-warning text-dark">Roaster Preparing</span></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-warning btn-lg fw-bold text-dark rounded-pill px-4">
                        <i class="bi bi-bag-plus me-1"></i> Order More Coffee
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                        Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
