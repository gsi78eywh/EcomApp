@{
    ViewData["Title"] = "Order Confirmation";
    var orderId = ViewBag.OrderId as string ?? "LUSI-ORDER";
    var customerName = ViewBag.CustomerName as string ?? "Coffee Purist";
    var totalPaid = ViewBag.TotalPaid as string ?? "$0.00";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <!-- Success Emblem -->
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" 
                         style="width: 84px; height: 84px; background: rgba(46, 142, 83, 0.12); color: #2e8e53;">
                        <i class="bi bi-check2-circle display-4"></i>
                    </div>
                </div>

                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small fw-bold mb-2">
                    Payment Verified & Received
                </span>

                <h1 class="brand-font fw-bold mb-2">Thank You, @customerName!</h1>
                <p class="lead text-muted mb-4" style="font-size: 1.1rem;">
                    Your coffee order has been queued at our roastery and is being prepared for roasting.
                </p>

                <!-- Order Status Timeline -->
                <div class="order-timeline">
                    <div class="timeline-step completed">
                        <div class="timeline-step-icon"><i class="bi bi-check-lg"></i></div>
                        <div class="small fw-bold text-dark">Order Confirmed</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Payment captured</div>
                    </div>
                    <div class="timeline-step active">
                        <div class="timeline-step-icon"><i class="bi bi-fire"></i></div>
                        <div class="small fw-bold text-warning">Batch Roasting</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Drum profiling</div>
                    </div>
                    <div class="timeline-step">
                        <div class="timeline-step-icon"><i class="bi bi-award"></i></div>
                        <div class="small fw-semibold text-muted">Quality Cupping</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Flavor check</div>
                    </div>
                    <div class="timeline-step">
                        <div class="timeline-step-icon"><i class="bi bi-truck"></i></div>
                        <div class="small fw-semibold text-muted">Out for Delivery</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Dispatched</div>
                    </div>
                </div>

                <!-- Order Metadata Summary Card -->
                <div class="p-4 bg-light rounded-4 mb-4 text-start border">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small">Tracking Order ID</span>
                            <div class="fw-bold fs-5 text-dark font-monospace">@orderId</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Total Paid</span>
                            <div class="fw-bold fs-5 text-dark">@totalPaid</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Estimated Delivery</span>
                            <div class="fw-semibold text-dark">Within 24 – 48 Hours</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small">Roastery Status</span>
                            <div>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill">
                                    <i class="bi bi-fire me-1"></i> Drum Scheduled
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Storage & Brewing Pro-Tips -->
                <div class="p-3 rounded-3 mb-4 text-start small text-muted" style="background-color: var(--coffee-cream-100); border: 1px solid var(--coffee-border);">
                    <div class="fw-bold text-dark mb-1">
                        <i class="bi bi-lightbulb text-warning me-1"></i> Barista Care Instructions:
                    </div>
                    Keep your whole beans stored in their one-way valve bag at room temperature away from direct sunlight. For optimal clarity, allow the roast to rest 3–4 days post-roast date before brewing.
                </div>

                <!-- Action CTAs -->
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn-coffee-primary text-decoration-none px-4">
                        <i class="bi bi-cup-hot me-1"></i> Order More Coffee
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn-coffee-outline px-4">
                        Return to Roastery Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
