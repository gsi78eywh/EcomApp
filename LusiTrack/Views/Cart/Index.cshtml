@model CartViewModel
@{
    ViewData["Title"] = "Your Food & Drinks Tray | JMT CAFE Dalaguete";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="brand-font fw-bold mb-0">
            <i class="bi bi-bag-heart-fill text-warning me-2"></i> Your Food & Drinks Tray
        </h1>
        @if (Model.Items.Any())
        {
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                @Model.TotalItemsCount item@(Model.TotalItemsCount > 1 ? "s" : "") in order
            </span>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle p-4 mb-2">
                    <i class="bi bi-cup-hot display-3"></i>
                </div>
            </div>
            <h3 class="brand-font fw-bold mb-2">Your cart is currently empty</h3>
            <p class="text-muted max-w-500 mx-auto mb-4" style="max-width: 460px;">
                You haven't added any fresh single-origin brews, beans, or baked treats yet. Explore our handcrafted Cebu menu.
            </p>
            <div>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-gold btn-lg px-5 py-3 shadow">
                    <i class="bi bi-cup-straw me-2"></i> Explore Coffee Menu
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Free Shipping Progress Meter -->
        @if (!Model.IsPickup)
        {
            var threshold = 1000m;
            var subtotal = Model.Subtotal;
            var pct = Math.Min(100, (int)((subtotal / threshold) * 100));
            var remaining = Math.Max(0, threshold - subtotal);

            <div class="shipping-meter-card mb-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    @if (subtotal >= threshold)
                    {
                        <span class="fw-bold text-success small">
                            <i class="bi bi-gift-fill me-1"></i> Congratulations! You've qualified for <strong>FREE Dalaguete Delivery</strong>!
                        </span>
                        <span class="badge bg-success text-white fw-bold">Unlocked</span>
                    }
                    else
                    {
                        <span class="fw-bold text-dark small">
                            <i class="bi bi-truck text-warning me-1"></i> Add <strong>₱@remaining.ToString("N2")</strong> more to unlock <strong>FREE Delivery</strong> across Dalaguete & Southern Cebu!
                        </span>
                        <span class="fw-bold text-muted small">@pct%</span>
                    }
                </div>
                <div class="shipping-progress">
                    <div class="shipping-progress-bar" style="width: @pct%;"></div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Items Table Column -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="py-3 ps-4">Product & Customization</th>
                                    <th scope="col" class="py-3 text-center">Price</th>
                                    <th scope="col" class="py-3 text-center">Quantity</th>
                                    <th scope="col" class="py-3 text-end">Total</th>
                                    <th scope="col" class="py-3 pe-4 text-center">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-start gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" 
                                                     class="rounded-3 shadow-sm flex-shrink-0" style="width: 72px; height: 72px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" 
                                                       class="fw-bold text-dark text-decoration-none d-block">
                                                        @item.ProductName
                                                    </a>
                                                    <!-- Customization Tags -->
                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                        @if (!string.IsNullOrEmpty(item.Size) && item.Size != "Standard")
                                                        {
                                                            <span class="badge bg-light text-secondary border">@item.Size</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.Temperature) && item.Temperature != "Standard")
                                                        {
                                                            <span class="badge bg-light text-secondary border">@item.Temperature</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.MilkOption) && item.MilkOption != "None" && item.MilkOption != "Regular Milk")
                                                        {
                                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning">@item.MilkOption</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.FlavorSyrup) && item.FlavorSyrup != "None")
                                                        {
                                                            <span class="badge bg-info bg-opacity-10 text-primary border border-info border-opacity-25">
                                                                <i class="bi bi-magic me-1"></i>@item.FlavorSyrup
                                                            </span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.SweetnessLevel) && item.SweetnessLevel != "None" && item.SweetnessLevel != "100% Normal")
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-dark border">
                                                                <i class="bi bi-sliders me-1"></i>@item.SweetnessLevel
                                                            </span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.AddOns) && item.AddOns != "None")
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                                <i class="bi bi-plus-circle me-1"></i>@item.AddOns
                                                            </span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                                    {
                                                        <small class="text-muted fst-italic d-block mt-1">
                                                            <i class="bi bi-chat-quote me-1"></i>"@item.SpecialInstructions"
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold">₱@item.Price.ToString("N2")</td>
                                        <td class="text-center" style="width: 140px;">
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="itemId" value="@item.ItemId" />
                                                <div class="input-group input-group-sm" style="width: 104px;">
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary px-2" @(item.Quantity <= 1 ? "disabled" : "")>-</button>
                                                    <span class="form-control text-center fw-bold bg-white">@item.Quantity</span>
                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary px-2">+</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-success">₱@item.TotalPrice.ToString("N2")</td>
                                        <td class="pe-4 text-center">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="itemId" value="@item.ItemId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Remove">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                        <form asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to clear your cart?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold">
                                <i class="bi bi-trash me-1"></i> Clear Cart
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Fulfillment Method Toggle -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="brand-font fw-bold mb-3">
                        <i class="bi bi-geo-alt-fill text-warning me-2"></i> Fulfillment Preference
                    </h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <form asp-action="SetFulfillment" method="post">
                                <input type="hidden" name="isPickup" value="false" />
                                <button type="submit" class="w-100 text-start btn p-3 rounded-3 border @(!Model.IsPickup ? "border-warning bg-warning bg-opacity-10 shadow-sm" : "border-light bg-light text-muted")">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-dark"><i class="bi bi-truck me-2 text-warning"></i> Doorstep Delivery</span>
                                        @if (!Model.IsPickup) { <i class="bi bi-check-circle-fill text-warning"></i> }
                                    </div>
                                    <small class="d-block text-secondary">Dispatched locally in Dalaguete (₱50, Free over ₱1,000)</small>
                                </button>
                            </form>
                        </div>
                        <div class="col-sm-6">
                            <form asp-action="SetFulfillment" method="post">
                                <input type="hidden" name="isPickup" value="true" />
                                <button type="submit" class="w-100 text-start btn p-3 rounded-3 border @(Model.IsPickup ? "border-warning bg-warning bg-opacity-10 shadow-sm" : "border-light bg-light text-muted")">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-dark"><i class="bi bi-shop me-2 text-warning"></i> JMT Cafe Onsite Pickup</span>
                                        @if (Model.IsPickup) { <i class="bi bi-check-circle-fill text-warning"></i> }
                                    </div>
                                    <small class="d-block text-secondary">Pick up free at JMT CAFE • Purok 5 Tabon, Dalaguete</small>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sticky Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 p-4 bg-white sticky-top" style="top: 90px;">
                    <h4 class="brand-font fw-bold mb-3">Order Summary</h4>

                    <!-- Promo Voucher Form -->
                    <form asp-action="ApplyCoupon" method="post" class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Have a Promo Voucher?</label>
                        <div class="input-group">
                            <input type="text" name="couponCode" value="@Model.CouponCode" class="form-control text-uppercase form-control-sm rounded-start-pill ps-3" placeholder="e.g. JMT10, DALAGUETE50" />
                            <button type="submit" class="btn btn-dark btn-sm px-3 fw-bold rounded-end-pill">Apply</button>
                        </div>
                        <small class="text-muted d-block mt-1">Try voucher code <strong class="text-warning">JMT10</strong> or <strong class="text-warning">DALAGUETE50</strong></small>
                    </form>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Subtotal (@Model.TotalItemsCount items)</span>
                        <span class="fw-semibold">₱@Model.Subtotal.ToString("N2")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Promo Discount (@Model.CouponCode)</span>
                            <span class="fw-bold">-₱@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Estimated Local VAT (5%)</span>
                        <span class="fw-semibold">₱@Model.EstimatedTax.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Fulfillment</span>
                        @if (Model.IsPickup)
                        {
                            <span class="text-success fw-bold">FREE PICKUP</span>
                        }
                        else if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">FREE CEBU DELIVERY</span>
                        }
                        else
                        {
                            <span class="fw-semibold">₱@Model.ShippingFee.ToString("N2")</span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5">Total Due</span>
                        <span class="fw-bold fs-4 text-success">₱@Model.GrandTotal.ToString("N2")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-gold btn-lg w-100 fw-bold shadow">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="text-center mt-3 text-muted small">
                        <i class="bi bi-shield-check text-primary me-1"></i> 100% Pre-Paid via GCash Verified Merchant &bull; Zero Failed Deliveries
                    </div>
                </div>
            </div>
        </div>
    }
</div>
