@model CartViewModel
@{
    ViewData["Title"] = "Your Shopping Cart";
    var freeShippingThreshold = 35.00m;
    var progressPercent = Model.Subtotal >= freeShippingThreshold ? 100 : (int)Math.Min(100, (Model.Subtotal / freeShippingThreshold) * 100);
    var remainingForFreeShipping = Math.Max(0, freeShippingThreshold - Model.Subtotal);
}

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="brand-font fw-bold display-6 mb-0">
            <i class="bi bi-bag-check-fill text-warning me-2"></i> Your Coffee Bag
        </h1>
        @if (Model.Items.Any())
        {
            <span class="badge bg-white border text-dark px-3 py-2 rounded-pill small fw-semibold">
                @Model.TotalItemsCount @(Model.TotalItemsCount == 1 ? "Harvest Item" : "Harvest Items")
            </span>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <!-- Empty Cart State -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mb-4">
                <div class="brand-icon-wrap mx-auto" style="width: 80px; height: 80px; font-size: 2.2rem;">
                    <i class="bi bi-cup-hot"></i>
                </div>
            </div>
            <h3 class="brand-font fw-bold mb-2">Your coffee bag is empty</h3>
            <p class="text-muted max-w-500 mx-auto mb-4">
                Fill it with single-origin beans, craft espresso drinks, or morning pastries fresh from our roastery.
            </p>
            <div>
                <a asp-controller="Shop" asp-action="Index" class="btn-coffee-primary text-decoration-none">
                    <i class="bi bi-compass me-1"></i> Discover Our Reserve Roasts
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Items Column -->
            <div class="col-lg-8">
                <!-- Free Shipping Progress Tracker -->
                <div class="free-shipping-box">
                    <div class="d-flex justify-content-between align-items-center small fw-semibold">
                        @if (remainingForFreeShipping == 0)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> <strong>Congratulations!</strong> You qualify for <strong>FREE Delivery</strong>!</span>
                            <span class="badge bg-success text-white">Unlocked</span>
                        }
                        else
                        {
                            <span class="text-dark"><i class="bi bi-truck text-warning me-1"></i> Add <strong>@remainingForFreeShipping.ToString("C")</strong> more for <strong>FREE Delivery</strong>!</span>
                            <span class="text-muted">@progressPercent%</span>
                        }
                    </div>
                    <div class="shipping-progress-track">
                        <div class="shipping-progress-fill" style="width: @progressPercent%;"></div>
                    </div>
                </div>

                <!-- Products Table Card -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <tr>
                                    <th scope="col" class="py-3 ps-4">Product</th>
                                    <th scope="col" class="py-3 text-center">Unit Price</th>
                                    <th scope="col" class="py-3 text-center">Quantity</th>
                                    <th scope="col" class="py-3 text-end">Total</th>
                                    <th scope="col" class="py-3 pe-4 text-center">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <!-- Product Image & Title -->
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" 
                                                     class="rounded-3 shadow-sm" style="width: 68px; height: 68px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" 
                                                       class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="text-muted small">Specialty Roasted</div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Unit Price -->
                                        <td class="text-center fw-semibold text-secondary">
                                            @item.Price.ToString("C")
                                        </td>

                                        <!-- Stepper Form -->
                                        <td class="text-center" style="width: 160px;">
                                            <form asp-action="UpdateQuantity" method="post" class="d-inline-flex justify-content-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <div class="qty-stepper">
                                                    <button type="button" class="btn-step" 
                                                            onclick="let input=this.nextElementSibling;if(input.value>1){input.value--;this.form.submit();}">
                                                        &minus;
                                                    </button>
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" 
                                                           onchange="this.form.submit()" />
                                                    <button type="button" class="btn-step" 
                                                            onclick="let input=this.previousElementSibling;input.value++;this.form.submit();">
                                                        &#43;
                                                    </button>
                                                </div>
                                            </form>
                                        </td>

                                        <!-- Line Total -->
                                        <td class="text-end fw-bold text-dark fs-6">
                                            @item.TotalPrice.ToString("C")
                                        </td>

                                        <!-- Remove Action -->
                                        <td class="pe-4 text-center">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-1" 
                                                        style="width: 32px; height: 32px;" title="Remove this item">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Cart Footer Buttons -->
                    <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-coffee-outline">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                        <form asp-action="Clear" method="post" onsubmit="return confirm('Clear all items from your coffee cart?');">
                            <button type="submit" class="btn btn-sm btn-outline-secondary border-0 text-muted">
                                <i class="bi bi-x-circle me-1"></i> Clear Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sticky Order Summary Column -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
                    <h4 class="brand-font fw-bold mb-3">Order Summary</h4>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Subtotal (@Model.TotalItemsCount items)</span>
                        <span class="fw-semibold">@Model.Subtotal.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Estimated Tax (8%)</span>
                        <span class="fw-semibold">@Model.EstimatedTax.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Specialty Delivery</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@Model.ShippingFee.ToString("C")</span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4 fs-5">
                        <span class="fw-bold text-dark">Estimated Total</span>
                        <span class="fw-bold text-dark">@Model.GrandTotal.ToString("C")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn-coffee-primary w-100 py-3 text-decoration-none shadow mb-3">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <!-- Security & Freshness Guarantee -->
                    <div class="p-3 bg-light rounded-3 text-center small text-muted">
                        <div class="d-flex align-items-center justify-content-center gap-2 mb-1 text-success fw-semibold">
                            <i class="bi bi-shield-lock-fill"></i> 256-Bit SSL Encrypted
                        </div>
                        <div>Roasted to order. Hand-inspected before dispatch.</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
