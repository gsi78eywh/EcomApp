@model CartViewModel
@{
    ViewData["Title"] = "Your Shopping Cart";
}

<div class="container py-4">
    <h1 class="brand-font fw-bold mb-4">
        <i class="bi bi-bag-heart-fill text-warning me-2"></i> Your Coffee Cart
    </h1>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mb-3">
                <i class="bi bi-cup-hot text-muted display-1"></i>
            </div>
            <h3 class="brand-font fw-bold">Your cart is currently empty</h3>
            <p class="text-muted">Looks like you haven't added any fresh brews or roasts yet.</p>
            <div class="mt-3">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-warning btn-lg px-4 py-2 rounded-pill fw-bold text-dark shadow-sm">
                    Explore Coffee Menu
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="py-3 ps-4">Product</th>
                                    <th scope="col" class="py-3 text-center">Price</th>
                                    <th scope="col" class="py-3 text-center">Quantity</th>
                                    <th scope="col" class="py-3 text-end">Total</th>
                                    <th scope="col" class="py-3 pe-4 text-center">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" 
                                                     class="rounded-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" 
                                                       class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Price.ToString("C")</td>
                                        <td class="text-center" style="width: 140px;">
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" 
                                                       class="form-control form-control-sm text-center fw-semibold" style="width: 60px;" 
                                                       onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-success">@item.TotalPrice.ToString("C")</td>
                                        <td class="pe-4 text-center">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Remove">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                        <form asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to clear your cart?');">
                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill text-danger">
                                Clear Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Order Summary Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 90px;">
                    <h4 class="brand-font fw-bold mb-4">Order Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal (@Model.TotalItemsCount items)</span>
                        <span class="fw-semibold">@Model.Subtotal.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estimated Tax (8%)</span>
                        <span class="fw-semibold">@Model.EstimatedTax.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Shipping</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@Model.ShippingFee.ToString("C")</span>
                        }
                    </div>

                    @if (Model.Subtotal < 35 && Model.Subtotal > 0)
                    {
                        <div class="alert alert-warning small py-2 mb-3">
                            <i class="bi bi-info-circle me-1"></i> Add <strong>@((35 - Model.Subtotal).ToString("C"))</strong> more for <strong>FREE Shipping</strong>!
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between mb-4 fs-5">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold text-success">@Model.GrandTotal.ToString("C")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-sm">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="text-center mt-3 text-muted small">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Safe & Secure Checkout
                    </div>
                </div>
            </div>
        </div>
    }
</div>
