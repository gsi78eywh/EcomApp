@{
    ViewData["Title"] = "Privacy Policy | JMT CAFE Dalaguete";
}

<!-- Hero Section -->
<section class="py-5 text-white mb-5 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 80% 20%, rgba(212, 163, 115, 0.25) 0%, transparent 60%), linear-gradient(135deg, #0b0604 0%, #1c1009 50%, #3e2416 100%); border-bottom: 1px solid rgba(212, 163, 115, 0.2);">
    <div class="container py-4 text-center">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 mx-auto" 
             style="background: rgba(212, 163, 115, 0.18); border: 1px solid rgba(212, 163, 115, 0.4);">
            <i class="bi bi-shield-lock-fill text-warning"></i>
            <span class="text-warning small fw-bold text-uppercase" style="letter-spacing: 0.08em;">Compliance & Data Protection</span>
        </div>
        <h1 class="display-4 fw-bold brand-font mb-3">Privacy Statement</h1>
        <p class="lead max-w-700 mx-auto text-light opacity-90" style="max-width: 680px; line-height: 1.8;">
            JMT CAFE is committed to protecting your privacy in compliance with Republic Act No. 10173 (The Data Privacy Act of 2012 of the Republic of the Philippines).
        </p>
    </div>
</section>

<div class="container mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h5 class="fw-bold brand-font text-dark mb-3">1. Scope and Controller</h5>
                <p class="text-secondary small mb-4" style="line-height: 1.8;">
                    This Privacy Policy applies to the official website and digital inquiry channels of <strong>JMT CAFE</strong> ("we", "our", or "us"), located at <strong>Purok 5 Tabon, Dalaguete, 6022 Cebu, Philippines</strong>. We collect and process personal data strictly to fulfill table reservations, food orders, customer feedback, and franchise inquiries.
                </p>

                <h5 class="fw-bold brand-font text-dark mb-3">2. Information We Collect</h5>
                <p class="text-secondary small mb-2" style="line-height: 1.8;">
                    Depending on how you interact with our website, we may collect:
                </p>
                <ul class="text-secondary small mb-4" style="line-height: 1.8;">
                    <li><strong>Contact Information:</strong> Name, phone number, and email address submitted voluntarily through our Contact or Franchise inquiry forms.</li>
                    <li><strong>Inquiry & Reservation Details:</strong> Dining preferences, date/time requests, or questions submitted when inquiring via phone or Facebook Messenger.</li>
                    <li><strong>Technical Diagnostics:</strong> Standard web server logs (IP address, browser user-agent, timestamps) collected for security monitoring and operational stability.</li>
                </ul>

                <h5 class="fw-bold brand-font text-dark mb-3">3. Purpose and Legal Basis of Processing</h5>
                <p class="text-secondary small mb-4" style="line-height: 1.8;">
                    Under RA 10173, we process personal data with your explicit consent and for legitimate business purposes, specifically:
                    (a) to confirm dining reservations and advance order preparations;
                    (b) to answer customer inquiries submitted via our web forms;
                    (c) to review franchise partnership requests; and
                    (d) to ensure the security and integrity of our online platform.
                </p>

                <h5 class="fw-bold brand-font text-dark mb-3">4. Third-Party Services & Embeds</h5>
                <p class="text-secondary small mb-4" style="line-height: 1.8;">
                    Our website features embedded services to enhance your experience:
                    <strong>Google Maps</strong> and <strong>OpenStreetMap</strong> for physical wayfinding, and <strong>Meta (Facebook)</strong> for customer communications. These external providers may set analytical or functional cookies in accordance with their respective privacy policies.
                </p>

                <h5 class="fw-bold brand-font text-dark mb-3">5. Data Retention & Security</h5>
                <p class="text-secondary small mb-4" style="line-height: 1.8;">
                    We implement organizational, physical, and technical measures to protect your personal data against unauthorized disclosure or loss. Contact submissions are retained only as long as necessary to resolve your inquiry, after which they are securely archived or deleted.
                </p>

                <h5 class="fw-bold brand-font text-dark mb-3">6. Your Rights under RA 10173</h5>
                <p class="text-secondary small mb-4" style="line-height: 1.8;">
                    As a data subject, you have the right to be informed, access, correct, or request the deletion of your personal data held by JMT CAFE. To exercise these rights, reach out to our management team via:
                </p>
                <div class="p-3 rounded-3 bg-light border text-secondary small">
                    <div><strong>Data Protection Officer / Cafe Management</strong></div>
                    <div>JMT CAFE &bull; Purok 5 Tabon, Dalaguete, 6022 Cebu, Philippines</div>
                    <div>Mobile: <strong>0919 331 4702</strong> &bull; Facebook: <a href="https://www.facebook.com/profile.php?id=61566969959363" target="_blank" class="text-warning fw-semibold">JMT CAFE Official Page</a></div>
                </div>

                <div class="mt-4 pt-3 border-top text-muted small">
                    Last updated: September 2026 &bull; Published by JMT Cafe Operations
                </div>
            </div>
        </div>
    </div>
</div>
