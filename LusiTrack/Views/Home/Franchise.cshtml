@{
    ViewData["Title"] = "Group Dining, Events & Partnerships | JMT CAFE Dalaguete";
}

<!-- Hero Header -->
<section class="py-5 text-white mb-5 position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 80% 20%, rgba(212, 163, 115, 0.22) 0%, transparent 60%), linear-gradient(135deg, #0b0604 0%, #1c1009 50%, #3e2416 100%); border-bottom: 1px solid rgba(212, 163, 115, 0.2);">
    <div class="container py-4 text-center">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 mx-auto" 
             style="background: rgba(212, 163, 115, 0.18); border: 1px solid rgba(212, 163, 115, 0.4);">
            <i class="bi bi-people-fill text-warning"></i>
            <span class="text-warning small fw-bold text-uppercase" style="letter-spacing: 0.08em;">Group Dining & Collaborations</span>
        </div>
        <h1 class="display-4 fw-bold brand-font mb-3">Events, Catering & Partnerships</h1>
        <p class="lead max-w-700 mx-auto text-light opacity-90" style="max-width: 720px; line-height: 1.8;">
            Planning a gathering in the Dalaguete highlands? From tour group meals and barkada celebrations to local business collaborations, JMT CAFE is here to host and serve you with fresh comfort food and warm hospitality.
        </p>
    </div>
</section>

<div class="container mb-5">
    @if (TempData["FranchiseSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-4 mb-4" role="alert" style="background: #eef9f1; color: #1e6b36;">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                <div>
                    <h5 class="fw-bold mb-1">Inquiry Sent</h5>
                    <p class="mb-0">@TempData["FranchiseSuccess"]</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 3 Core Service Pillars -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-warning text-dark px-3 py-1 text-uppercase fw-bold mb-2 rounded-pill small">How We Can Serve You</span>
            <h2 class="brand-font display-6 fw-bold mb-2">Ways to Partner & Celebrate With Us</h2>
            <p class="text-muted max-w-600 mx-auto" style="max-width: 650px;">
                Whether you're organizing an Osmeña Peak tour or looking to collaborate with our cafe brand, we make planning simple.
            </p>
        </div>

        <div class="row g-4 mb-4">
            <!-- Pillar 1: Tour Groups & Barkadas -->
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-inline-flex p-3 rounded-3 bg-warning bg-opacity-10 text-warning fs-3 mb-3">
                        <i class="bi bi-compass"></i>
                    </div>
                    <h4 class="brand-font fw-bold mb-2 text-dark">Tour Groups & Hikers</h4>
                    <p class="text-muted small mb-3">
                        Ascending Osmeña Peak or touring Southern Cebu? Pre-book table seating on our open-air rooftop viewing deck with hot meals and coffee waiting on arrival.
                    </p>
                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-4 mt-auto">
                        <li><i class="bi bi-check2 text-warning me-2 fw-bold"></i>Rooftop deck seating with mountain breeze</li>
                        <li><i class="bi bi-check2 text-warning me-2 fw-bold"></i>Advance meal staging for fast turnaround</li>
                        <li><i class="bi bi-check2 text-warning me-2 fw-bold"></i>Convenient roadside van & motorcycle parking</li>
                    </ul>
                    <a href="#inquiryFormSection" class="btn btn-outline-dark rounded-pill fw-semibold btn-sm py-2">
                        Reserve for Your Group &rarr;
                    </a>
                </div>
            </div>

            <!-- Pillar 2: Party Burgers & Bulk Catering -->
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white border-top border-warning border-4">
                    <div class="d-inline-flex p-3 rounded-3 bg-danger bg-opacity-10 text-danger fs-3 mb-3">
                        <i class="bi bi-gift"></i>
                    </div>
                    <h4 class="brand-font fw-bold mb-2 text-dark">Party Platters & Catering</h4>
                    <p class="text-muted small mb-3">
                        From our signature Giant 10-Inch Party Burgers to large batches of chicken meals and fruit shakes, we prepare fresh platters for birthdays and family feasts.
                    </p>
                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-4 mt-auto">
                        <li><i class="bi bi-check2 text-danger me-2 fw-bold"></i>Colossal 10-Inch Burgers with fries</li>
                        <li><i class="bi bi-check2 text-danger me-2 fw-bold"></i>Rice meal & silog banquet trays</li>
                        <li><i class="bi bi-check2 text-danger me-2 fw-bold"></i>Chilled mojitos and fruit shake batches</li>
                    </ul>
                    <a href="#inquiryFormSection" class="btn btn-warning text-dark rounded-pill fw-bold btn-sm py-2 shadow-sm">
                        Inquire for Platters &rarr;
                    </a>
                </div>
            </div>

            <!-- Pillar 3: Business Collaborations -->
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-inline-flex p-3 rounded-3 bg-success bg-opacity-10 text-success fs-3 mb-3">
                        <i class="bi bi-shop-window"></i>
                    </div>
                    <h4 class="brand-font fw-bold mb-2 text-dark">Business Partnerships</h4>
                    <p class="text-muted small mb-3">
                        Interested in opening a branch, supplying local farm produce, or hosting brand events in Dalaguete? We are always open to exploring genuine partnerships.
                    </p>
                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-4 mt-auto">
                        <li><i class="bi bi-check2 text-success me-2 fw-bold"></i>Branch expansion & kiosk licensing</li>
                        <li><i class="bi bi-check2 text-success me-2 fw-bold"></i>Direct founder & kitchen SOP training</li>
                        <li><i class="bi bi-check2 text-success me-2 fw-bold"></i>Local supplier & event collaborations</li>
                    </ul>
                    <a href="#inquiryFormSection" class="btn btn-outline-dark rounded-pill fw-semibold btn-sm py-2">
                        Discuss Collaboration &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Clean 3-Step Coordination Process -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-light">
        <div class="text-center mb-4">
            <span class="badge bg-white text-dark border px-3 py-1 text-uppercase fw-bold mb-2 rounded-pill small">Simple & Direct</span>
            <h3 class="brand-font fw-bold mb-1">How We Coordinate</h3>
            <p class="text-muted small mb-0">No complicated red tape—just honest, straightforward hospitality</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-xs fs-4 fw-bold text-warning mb-3" style="width: 52px; height: 52px;">1</div>
                    <h5 class="fw-bold mb-2">Send Your Request</h5>
                    <p class="small text-muted mb-0">Fill out the quick form below or message our official Facebook page with your date and details.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-xs fs-4 fw-bold text-warning mb-3" style="width: 52px; height: 52px;">2</div>
                    <h5 class="fw-bold mb-2">We Confirm the Setup</h5>
                    <p class="small text-muted mb-0">We will finalize your menu selection, reserve seating on the deck, and prepare a clear quote.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-xs fs-4 fw-bold text-warning mb-3" style="width: 52px; height: 52px;">3</div>
                    <h5 class="fw-bold mb-2">Enjoy Your Gathering</h5>
                    <p class="small text-muted mb-0">Arrive at JMT Cafe in Dalaguete to hot meals, cold drinks, fresh mountain breeze, and great company!</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Inquiry Form & Quick Contact Row -->
    <div class="row g-5" id="inquiryFormSection">
        <!-- Left: Quick Direct Contact -->
        <div class="col-lg-5">
            <span class="badge bg-warning text-dark px-3 py-1 text-uppercase fw-bold mb-2 rounded-pill small">Direct Access</span>
            <h2 class="brand-font display-6 fw-bold mb-3">Need a Fast Response?</h2>
            <p class="text-secondary lead fs-6 mb-4" style="line-height: 1.8;">
                If your event is this weekend or you need immediate confirmation, reaching out through our direct messaging channels is the fastest way to reach us.
            </p>

            <div class="d-flex flex-column gap-3 mb-4">
                <a href="https://www.facebook.com/profile.php?id=61566969959363" target="_blank" rel="noopener noreferrer"
                   class="d-flex align-items-center gap-3 p-3 rounded-4 bg-white shadow-sm border text-decoration-none text-dark hover-gold">
                    <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-4 flex-shrink-0">
                        <i class="bi bi-messenger"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Message on Facebook</h6>
                        <small class="text-muted d-block">Instant chat with our staff for orders & reservations</small>
                    </div>
                </a>

                <a href="tel:09193314702" class="d-flex align-items-center gap-3 p-3 rounded-4 bg-white shadow-sm border text-decoration-none text-dark hover-gold">
                    <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success fs-4 flex-shrink-0">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Call 0919 331 4702</h6>
                        <small class="text-muted d-block">Open daily from 9:00 AM to 10:00 PM</small>
                    </div>
                </a>

                <div class="p-3 rounded-4 bg-white shadow-sm border">
                    <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                        <i class="bi bi-geo-alt-fill"></i>
                        <h6 class="fw-bold mb-0 text-dark">Location & Stopover</h6>
                    </div>
                    <p class="small text-muted mb-0">
                        Purok 5 Tabon, Dalaguete, 6022 Cebu &bull; Along the scenic Dalaguete–Mantalongon mountain highway near the Tabon Basketball Court.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                <h4 class="brand-font fw-bold mb-2 text-dark">Send an Inquiry</h4>
                <p class="text-muted small mb-4">Please share a few details and our cafe team will get back to you promptly.</p>

                <form method="post" asp-action="Franchise">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Your Name *</label>
                        <input type="text" name="fullName" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Junrey Duterte" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Email Address *</label>
                            <input type="email" name="email" class="form-control rounded-pill px-3 py-2" placeholder="name@domain.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Mobile / Contact Number *</label>
                            <input type="tel" name="phone" class="form-control rounded-pill px-3 py-2" placeholder="0919 331 4702" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Event Location or Town *</label>
                        <input type="text" name="proposedLocation" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Dalaguete, Oslob, Argao, or Cebu City" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Inquiry Type</label>
                            <select name="experience" class="form-select rounded-pill px-3 py-2">
                                <option value="Tour Group / Hikers Dining">Tour Group / Hikers Dining</option>
                                <option value="Birthday / Barkada Celebration">Birthday / Barkada Celebration</option>
                                <option value="Party Burger Bulk Order">Party Burger & Meal Platter Order</option>
                                <option value="Cafe Partnership / Expansion">Business / Cafe Collaboration</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Estimated Group Size / Budget</label>
                            <select name="investmentRange" class="form-select rounded-pill px-3 py-2">
                                <option value="Small Group (5–10 Guests)">Small Group (5–10 Guests)</option>
                                <option value="Medium Group (10–25 Guests)">Medium Group (10–25 Guests)</option>
                                <option value="Large Gathering (25+ Guests)">Large Gathering (25+ Guests)</option>
                                <option value="Business Partnership Discussion">Business Partnership Discussion</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark">Your Message or Event Details</label>
                        <textarea name="message" rows="3" class="form-control rounded-4 p-3" placeholder="Tell us your target date, preferred dishes (e.g. 10-Inch Burgers, Mojitos, Rice Meals), or any questions for our team..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 rounded-pill py-3 fw-bold text-dark shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Send Inquiry to JMT Cafe
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
