@model IEnumerable<CoffeeProduct>
@{
    ViewData["Title"] = "Artisanal Coffee & Roastery";
    var categories = ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<!-- Hero Section -->
<section class="py-5 text-white mb-5 shadow-sm" style="background: linear-gradient(135deg, #20130b 0%, #3d2314 60%, #683b1d 100%);">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-3 rounded-pill">
                    <i class="bi bi-stars"></i> Specialty Grade Coffee
                </span>
                <h1 class="display-3 fw-bold mb-3 brand-font">Freshly Roasted.<br />Obsessively Brewed.</h1>
                <p class="lead mb-4 opacity-75">
                    Experience rich aromas, single-origin roasts, and crafted espresso drinks made from ethically sourced beans harvested at peak ripeness.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-warning btn-lg px-4 py-3 fw-bold text-dark rounded-pill shadow-sm">
                        <i class="bi bi-cup-hot-fill me-2"></i> Explore Our Menu
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold rounded-pill">
                        Our Story
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80" 
                     alt="Artisanal Pour-Over Coffee" 
                     class="img-fluid rounded-4 shadow-lg border border-warning border-opacity-25" 
                     style="max-height: 420px; object-fit: cover;" />
            </div>
        </div>
    </div>
</section>

<div class="container">
    <!-- Value Badges -->
    <div class="row g-4 text-center mb-5">
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 shadow-sm h-100 border">
                <i class="bi bi-award text-warning fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold mb-1">Single-Origin</h6>
                <small class="text-muted">Top 1% harvest beans</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 shadow-sm h-100 border">
                <i class="bi bi-fire text-warning fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold mb-1">Micro-Roast</h6>
                <small class="text-muted">Roasted in small batches</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 shadow-sm h-100 border">
                <i class="bi bi-heart text-warning fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold mb-1">Ethical Trade</h6>
                <small class="text-muted">Direct farmer partnerships</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 shadow-sm h-100 border">
                <i class="bi bi-truck text-warning fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold mb-1">Fresh Delivery</h6>
                <small class="text-muted">Free on orders over $35</small>
            </div>
        </div>
    </div>

    <!-- Category Highlights -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="brand-font fw-bold mb-1">Featured Blends & Drinks</h2>
            <p class="text-muted mb-0">Hand-selected favorites recommended by our head roaster</p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-semibold btn-sm px-3">
            View All Menu <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <!-- Product Grid -->
    <div class="row g-4 mb-5">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card card-coffee h-100 d-flex flex-column">
                    <div class="position-relative">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;" />
                        <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75 badge-roast text-warning">
                            @item.Category
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-secondary bg-opacity-10 text-dark small">@item.RoastLevel</span>
                            <span class="fw-bold fs-5 text-success">@item.Price.ToString("C")</span>
                        </div>
                        <h5 class="card-title brand-font fs-6 fw-bold mb-2">
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                @item.Name
                            </a>
                        </h5>
                        <p class="card-text small text-muted flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>
                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm flex-fill">
                                Details
                            </a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn btn-warning btn-sm w-100 fw-semibold text-dark">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Callout Banner -->
    <div class="card text-white bg-dark rounded-4 p-4 p-md-5 my-5 shadow" style="background: radial-gradient(circle at 10% 20%, #3d2314 0%, #1f1109 90%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h3 class="brand-font fw-bold mb-2 text-warning">Want Coffee Delivered Every Week?</h3>
                <p class="mb-0 text-white-50">Join our subscription program for free deliveries, exclusive micro-lots, and customized grinding tailored to your espresso machine or French press.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-warning btn-lg fw-bold text-dark rounded-pill px-4">
                    Explore Subscription Beans
                </a>
            </div>
        </div>
    </div>
</div>
