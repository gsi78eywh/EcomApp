                            <button class="nav-link jmt-map-tab-btn" id="gmaps-tab" data-bs-toggle="pill" data-bs-target="#gmaps-pane" type="button" role="tab" aria-selected="false">
                                <i class="bi bi-google me-1"></i> Google Maps Listing
                            </button>
                        </li>
                    </ul>
                    <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="jmt-map-action-link" title="Open Google Maps in full tab with navigation">
                        <i class="bi bi-box-arrow-up-right"></i> Open in Maps App
                    </a>
                </div>

                <div class="tab-content" id="mapViewerTabContent">
                    <!-- Tab 1 (Default): Interactive Leaflet Map with Street & Satellite Dual Layers -->
                    <div class="tab-pane fade show active position-relative" id="osm-pane" role="tabpanel">
                        <div id="jmtOpenStreetMap" style="width: 100%; height: 470px; z-index: 1;"></div>
                        <!-- Quick Navigation Overlay Strip -->
                        <div class="position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-3 shadow-sm bg-white border d-none d-sm-flex align-items-center gap-2" style="z-index: 1000; border-color: rgba(212,163,115,0.4) !important; font-size: 0.75rem;">
                            <span class="fw-bold text-dark"><i class="bi bi-compass text-warning me-1"></i> Purok 5 Tabon, Dalaguete (Elevation ~800m)</span>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill py-0 px-2 fw-bold" style="font-size: 0.72rem;" onclick="recenterJmtMap()">
                                <i class="bi bi-crosshair me-1"></i> Recenter Cafe
                            </button>
                        </div>
                    </div>

                    <!-- Tab 2: Google Maps Embed with Verified Place Query & Direct App Link -->
                    <div class="tab-pane fade" id="gmaps-pane" role="tabpanel">
                        <div class="bg-light px-3 py-2 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="font-size: 0.78rem;">
                            <span class="text-secondary">
                                <i class="bi bi-info-circle text-warning me-1"></i> Google Maps Listing for <strong>@JmtCafeConfig.Name</strong> (@JmtCafeConfig.Landmark)
                            </span>
                            <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning rounded-pill fw-bold py-0 px-2" style="font-size: 0.72rem;">
                                <i class="bi bi-cursor-fill me-1"></i> Get Directions
                            </a>
                        </div>
                        <iframe src="@JmtCafeConfig.GoogleMapsEmbedUrl" 
                                width="100%" height="435" style="border:0; display: block;" allowfullscreen="" loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade" title="Google Maps JMT CAFE Location"></iframe>
                    </div>
                </div>
            </div>

            <!-- Right: Real Cafe Storefront Photograph & Verified Location Details -->
            <div class="col-lg-4 p-4 d-flex flex-column justify-content-between bg-light">
                <div>
                    <!-- Authentic Cafe Storefront Photo in Dalaguete Highlands -->
                    <div class="position-relative rounded-3 overflow-hidden shadow-sm mb-3" style="border: 2px solid #d4a373;">
                        <img src="/images/jmt/jmt_storefront_highlands.jpg" alt="JMT Cafe Storefront and Scenic Terrace in Dalaguete Highlands" class="w-100" style="height: 180px; object-fit: cover;" />
                        <div class="position-absolute bottom-0 start-0 w-100 p-2 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                            <div class="fw-bold small"><i class="bi bi-camera-fill me-1"></i> Authentic Storefront</div>
                            <div style="font-size: 0.72rem;" class="text-white-50">Highlands of Barangay Tabon, Dalaguete</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="brand-font fw-bold mb-0 text-dark">
                            <i class="bi bi-shop text-warning me-1"></i> @JmtCafeConfig.Name
                        </h5>
                        <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="badge bg-warning text-dark text-decoration-none fw-bold">
                            <i class="bi bi-star-fill me-1 text-dark"></i> Verified on Google
                        </a>
                    </div>
                    
                    <div class="mb-2 pb-2 border-bottom">
                        <div class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem;">Exact Address</div>
                        <div class="fw-bold text-dark small">@JmtCafeConfig.FullAddress</div>
                        <div class="text-muted small">Plus Code: <strong>@JmtCafeConfig.PlusCode</strong></div>
                        <div class="text-secondary small mt-1"><i class="bi bi-signpost-2 text-warning me-1"></i> @JmtCafeConfig.Landmark</div>
                    </div>

                    <div class="mb-2 pb-2 border-bottom">
                        <div class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem;">Contact & Hours</div>
                        <div class="fw-bold text-success small"><i class="bi bi-telephone-fill me-1"></i> @JmtCafeConfig.PhoneDisplay</div>
                        <div class="text-dark small"><i class="bi bi-clock-fill text-warning me-1"></i> <strong>@JmtCafeConfig.HoursDisplay</strong></div>
                    </div>

                    <div class="mb-3">
                        <div class="text-secondary small fw-bold text-uppercase mb-1" style="font-size: 0.72rem;">Amenities</div>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-white text-dark border shadow-xs"><i class="bi bi-wind text-info me-1"></i>Mountain Breeze</span>
                            <span class="badge bg-white text-dark border shadow-xs"><i class="bi bi-building text-warning me-1"></i>Rooftop Deck</span>
                            <span class="badge bg-white text-dark border shadow-xs"><i class="bi bi-wifi text-success me-1"></i>Free Wi-Fi</span>
                            <span class="badge bg-white text-dark border shadow-xs"><i class="bi bi-bag-check text-warning me-1"></i>Takeout</span>
                            <span class="badge bg-white text-dark border shadow-xs"><i class="bi bi-p-square-fill text-primary me-1"></i>Roadside Parking</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 pt-2 border-top">
                    <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" 
                       class="btn btn-warning rounded-pill fw-bold py-2 shadow-sm text-dark d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <span>Get Directions on Google Maps</span>
                    </a>
                    <a href="@JmtCafeConfig.PhoneTelLink" class="btn btn-outline-dark rounded-pill fw-bold py-2 small d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-telephone-fill text-success"></i>
                        <span>Call @JmtCafeConfig.PhoneDisplay</span>
                    </a>
                </div>
            </div>
        </div>
    </section>



</div>

@section Scripts {
    <!-- Leaflet JS & CSS for Free OpenStreetMap -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        // Starbucks-Style Dynamic Auto-Sliding Hero Carousel
        let currentSlide = 0;
        const totalSlides = 4;
        let slideTimer = null;
        let isCarouselPaused = false;
        const slideDuration = 4000;

        function showHeroSlide(idx) {
            currentSlide = (idx + totalSlides) % totalSlides;
            const slides = document.querySelectorAll('.starbucks-slide');
            const indicators = document.querySelectorAll('.starbucks-indicator-pill');
            
            slides.forEach((slide, i) => {
                slide.classList.toggle('active', i === currentSlide);
            });
            indicators.forEach((ind, i) => {
                ind.classList.toggle('active', i === currentSlide);
            });
            
            // Restart progress bar animation
            const activeBar = document.querySelector('.starbucks-indicator-pill.active .starbucks-progress-bar');
            if (activeBar && !isCarouselPaused) {
                activeBar.style.animation = 'none';
                void activeBar.offsetWidth;
                activeBar.style.animation = 'slideTimerFill 4s linear forwards';
            }
        }

        function nextHeroSlide() {
            showHeroSlide(currentSlide + 1);
        }

        function prevHeroSlide() {
            showHeroSlide(currentSlide - 1);
        }

        function gotoHeroSlide(idx) {
            showHeroSlide(idx);
            resetSlideTimer();
        }

        function startSlideTimer() {
            if (isCarouselPaused) return;
            stopSlideTimer();
            slideTimer = setInterval(nextHeroSlide, slideDuration);
        }

        function stopSlideTimer() {
            if (slideTimer) {
                clearInterval(slideTimer);
                slideTimer = null;
            }
        }

        function resetSlideTimer() {
            if (!isCarouselPaused) {
                startSlideTimer();
            }
        }

        window.toggleCarouselPlayPause = function() {
            isCarouselPaused = !isCarouselPaused;
            const btn = document.getElementById('carouselPlayPauseBtn');
            if (isCarouselPaused) {
                stopSlideTimer();
                if (btn) {
                    btn.innerHTML = '<i class="bi bi-play-fill"></i>';
                    btn.setAttribute('aria-label', 'Play Carousel');
                    btn.title = 'Play Carousel';
                }
            } else {
                startSlideTimer();
                if (btn) {
                    btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
                    btn.setAttribute('aria-label', 'Pause Carousel');
                    btn.title = 'Pause Carousel';
                }
            }
        };

        // Keyboard Controls (WCAG Arrow navigation)
        document.addEventListener('keydown', (e) => {
            const carousel = document.getElementById('starbucksHeroCarousel');
            if (!carousel) return;
            if (e.key === 'ArrowLeft') {
                prevHeroSlide();
                resetSlideTimer();
            } else if (e.key === 'ArrowRight') {
                nextHeroSlide();
                resetSlideTimer();
            }
        });

        // Initialize OpenStreetMap & Satellite Map for JMT Cafe with Verified Coordinates
        let jmtLeafletMap = null;
        const jmtCoords = [@JmtCafeConfig.Latitude, @JmtCafeConfig.Longitude];

        function initJmtMap() {
            const mapEl = document.getElementById('jmtOpenStreetMap');
            if (!mapEl || jmtLeafletMap) return;

            // Street Tile Layer (OpenStreetMap)
            const osmStreetLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            });

            // High-Resolution Satellite Layer (Esri World Imagery)
            const esriSatelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Dalaguete Highlands Satellite',
                maxZoom: 18
            });

            jmtLeafletMap = L.map('jmtOpenStreetMap', {
                center: jmtCoords,
                zoom: 17,
                zoomControl: true,
                scrollWheelZoom: false,
                layers: [osmStreetLayer]
            });

            // Base Layer Switcher (Street vs Satellite)
            const baseLayers = {
                "🗺️ Street Map": osmStreetLayer,
                "🛰️ Highland Satellite": esriSatelliteLayer
            };
            L.control.layers(baseLayers, null, { position: 'topright' }).addTo(jmtLeafletMap);

            // Custom Animated Coffee Pin
            const jmtIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `
                    <div style="position: relative; width: 44px; height: 44px;">
                        <div class="courier-pulse-ring" style="border-color: #ffc107; background: rgba(255,193,7,0.25);"></div>
                        <div class="location-marker-pin shadow" style="background: #180e07; border: 2.5px solid #ffc107; color: #ffc107; width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-cup-hot-fill"></i>
                        </div>
                    </div>
                `,
                iconSize: [44, 44],
                iconAnchor: [22, 22]
            });

            const marker = L.marker(jmtCoords, { icon: jmtIcon }).addTo(jmtLeafletMap);
            marker.bindPopup(`
                <div style="font-family: 'Plus Jakarta Sans', sans-serif; min-width: 250px; padding: 4px;">
                    <div style="font-weight: 800; font-size: 1.05rem; color: #150b06; margin-bottom: 2px;">
                        <i class="bi bi-shop text-warning me-1"></i> @JmtCafeConfig.Name
                    </div>
                    <div style="font-size: 0.85rem; color: #333; margin-bottom: 4px; font-weight: 500;">
                        @JmtCafeConfig.AddressLine1, @JmtCafeConfig.Municipality, 6022 Cebu
                    </div>
                    <div style="font-size: 0.78rem; color: #666; margin-bottom: 6px;">
                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> @JmtCafeConfig.Landmark
                    </div>
                    <div style="font-size: 0.75rem; background: #fff8e7; border: 1px solid #ffe08a; padding: 4px 8px; border-radius: 6px; color: #b8860b; font-weight: 700; margin-bottom: 8px;">
                        Mountain Breeze • Rooftop Deck • Free Wi-Fi • @JmtCafeConfig.HoursShort
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" 
                           style="flex: 1; text-align: center; background: #180e07; color: #ffc107; padding: 6px 10px; border-radius: 20px; text-decoration: none; font-weight: 700; font-size: 0.78rem; border: 1px solid #d4a373;">
                            <i class="bi bi-compass-fill me-1"></i> Directions
                        </a>
                        <a href="@JmtCafeConfig.PhoneTelLink" 
                           style="background: #e58b05; color: #fff; padding: 6px 12px; border-radius: 20px; text-decoration: none; font-weight: 700; font-size: 0.78rem;">
                            <i class="bi bi-telephone-fill"></i>
                        </a>
                    </div>
                </div>
            `).openPopup();
        }

        window.recenterJmtMap = function() {
            if (jmtLeafletMap) {
                jmtLeafletMap.setView(jmtCoords, 17);
                jmtLeafletMap.invalidateSize();
            }
        };

        window.refreshJmtOsm = function() {
            setTimeout(() => {
                initJmtMap();
                if (jmtLeafletMap) {
                    jmtLeafletMap.invalidateSize();
                }
            }, 150);
        };

        const osmTabEl = document.getElementById('osm-tab');
        if (osmTabEl) {
            osmTabEl.addEventListener('shown.bs.tab', () => {
                if (jmtLeafletMap) {
                    jmtLeafletMap.invalidateSize();
                } else {
                    initJmtMap();
                }
            });
        }

        // Initialize carousel and map on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            // Respect prefers-reduced-motion
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                isCarouselPaused = true;
                const btn = document.getElementById('carouselPlayPauseBtn');
                if (btn) btn.innerHTML = '<i class="bi bi-play-fill"></i>';
            } else {
                startSlideTimer();
            }

            const carousel = document.getElementById('starbucksHeroCarousel');
            if (carousel) {
                carousel.addEventListener('mouseenter', stopSlideTimer);
                carousel.addEventListener('mouseleave', () => {
                    if (!isCarouselPaused) startSlideTimer();
                });
            }
            initJmtMap();
        });
    </script>
}
