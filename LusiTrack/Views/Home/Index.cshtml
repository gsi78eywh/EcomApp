    <!-- Curated Best Sellers (8 Items, Not 38 Duplicate Cards) -->
    <section id="jmtMenuSection" class="mb-5 pt-3">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold rounded-pill text-uppercase small mb-2">
                    <i class="bi bi-star-fill me-1"></i> Customer Favorites
                </span>
                <h2 class="brand-font display-6 fw-bold mb-1">Popular Best Sellers</h2>
                <p class="text-muted mb-0">Prepared fresh in Dalaguete. Tap any item to view details or directions!</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/menu" class="btn btn-warning rounded-pill fw-bold text-dark px-4 py-2 shadow-sm">
                    View Full 38-Item Menu <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- 8 Best Seller Product Cards (CSS Grid Equal Height with Living Hover) -->
        <div class="row g-4 mb-4">
            @{ var cardIdx = 0; }
            @foreach (var item in Model)
            {
                cardIdx++;
                <div class="col-md-6 col-lg-3 reveal-on-scroll delay-@((cardIdx % 4) * 100)">
                    <div class="jmt-product-card" 
                         onclick='openJmtInquiryModal({ id: @item.Id, name: "@item.Name.Replace("\"", "\\\"")", price: @item.Price, imageUrl: "@item.ImageUrl", category: "@item.Category", description: "@item.Description.Replace("\"", "\\\"")" })'
                         role="button" tabindex="0" aria-label="View details for @item.Name">
                        
                        <!-- Thumbnail Wrapper: Photo Overlay or Item Name Showcase -->
                        <div style="aspect-ratio: 4/3; overflow: hidden; position: relative;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div class="position-relative w-100 h-100">
                                    <img src="@item.ImageUrl" class="card-img-top jmt-card-img" alt="@item.Name" loading="lazy" />
                                    
                                    <!-- Category Badge -->
                                    <div class="position-absolute top-0 start-0 m-2 d-flex flex-column gap-1 z-2">
                                        <span class="badge bg-dark bg-opacity-80 text-warning fw-semibold rounded-pill px-2 py-1 shadow-xs" style="font-size: 0.68rem; backdrop-filter: blur(4px);">
                                            @GetCategoryEmoji(item.Category) @item.Category
                                        </span>
                                    </div>

                                    <!-- Integrated Photo Overlay with Name & Price -->
                                    <div class="jmt-photo-name-overlay position-absolute bottom-0 start-0 end-0 p-2 d-flex justify-content-between align-items-end z-2">
                                        <span class="badge bg-black bg-opacity-75 text-white fw-bold rounded-pill px-2 py-1" style="font-size: 0.70rem; backdrop-filter: blur(6px); border: 1px solid rgba(212,163,115,0.35);">
                                            <i class="bi bi-camera-fill text-warning me-1"></i>Real Dish Photo
                                        </span>
                                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 fs-6 shadow-sm">
                                            ₱@item.Price.ToString("N0")
                                        </span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="jmt-menu-item-showcase jmt-showcase-@GetShowcaseTheme(item.Category)">
                                    <!-- Category Watermark Icon -->
                                    <div class="showcase-watermark-icon">
                                        <i class="@GetCategoryWatermarkIcon(item.Category)"></i>
                                    </div>

                                    <!-- Top Row: Category Pill & Authentic/Promo Stamp -->
                                    <div class="d-flex justify-content-between align-items-center w-100 position-relative z-2">
                                        <span class="badge bg-black bg-opacity-60 text-warning fw-semibold rounded-pill px-2 py-1" style="font-size: 0.68rem; border: 1px solid rgba(212, 163, 115, 0.35);">
                                            @GetCategoryEmoji(item.Category) @item.Category
                                        </span>
                                        @if (item.Name.Contains("Combo", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger text-white fw-bold rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-gift-fill me-1"></i>COMBO
                                            </span>
                                        }
                                        else if (item.Name.Contains("BUY 1 TAKE 1", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success text-white fw-bold rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-tag-fill me-1"></i>BUY 1 TAKE 1
                                            </span>
                                        }
                                        else if (item.Name.Contains("10-Inch", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("GIANT", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger text-white fw-bold rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-fire me-1"></i>10" PARTY
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="showcase-hallmark-stamp">
                                                <i class="bi bi-patch-check-fill text-warning"></i> Authentic
                                            </span>
                                        }
                                    </div>

                                    <!-- Center Hero: Menu Item Name Displayed on the Menu Card -->
                                    <div class="showcase-hero-center text-center my-auto py-1 position-relative z-2 w-100">
                                        <div class="showcase-badge-sub small text-warning fw-semibold mb-1">
                                            JMT Dalaguete Specialty
                                        </div>
                                        <h4 class="showcase-menu-title brand-font fw-bold text-white mb-2 px-1">
                                            @item.Name
                                        </h4>
                                        @if (item.TastingNotes != null && item.TastingNotes.Any())
                                        {
                                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                                @foreach (var note in item.TastingNotes.Take(2))
                                                {
                                                    <span class="showcase-feature-tag">@note</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Bottom Row: Dalaguete Seal & Price Tag -->
                                    <div class="d-flex justify-content-between align-items-center w-100 pt-2 showcase-footer-border position-relative z-2">
                                        <span class="showcase-origin-text">
                                            <i class="bi bi-geo-alt-fill text-warning"></i> Tabon, Dalaguete
                                        </span>
                                        <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 fs-6 shadow-sm">
                                            ₱@item.Price.ToString("N0")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="jmt-card-body">
                            <h3 class="brand-font fs-6 fw-bold mb-2 text-dark">
                                @item.Name
                            </h3>

                            <p class="small text-muted mb-3" style="line-height: 1.5; height: 42px; overflow: hidden;">
                                @(item.Description.Length > 85 ? item.Description.Substring(0, 82) + "..." : item.Description)
                            </p>

                            <!-- Tasting Chips -->
                            @if (item.TastingNotes != null && item.TastingNotes.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var note in item.TastingNotes.Take(2))
                                    {
                                        <span class="jmt-tasting-chip">@note</span>
                                    }
                                </div>
                            }

                            <!-- Card Footer with Clean Action Hint -->
                            <div class="jmt-card-action-hint">
                                <span class="action-tag"><i class="bi bi-eye-fill text-warning"></i> Tap for details</span>
                                <span class="text-warning fw-bold">View &rarr;</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Full Menu CTA Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center my-4" style="background: linear-gradient(135deg, #fbf7f2 0%, #ede3d4 100%); border: 1.5px solid rgba(212, 163, 115, 0.4) !important;">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-md-start">
                <div>
                    <h5 class="brand-font fw-bold text-dark mb-1">Looking for our complete catalog?</h5>
                    <p class="text-secondary small mb-0">We have 38 authentic items: budget silog rice meals, multi-burger party platters, large 16oz fruit shakes, and espresso drinks.</p>
                </div>
                <a href="/menu" class="btn btn-warning btn-lg px-4 py-2 rounded-pill fw-bold text-dark shadow-sm text-nowrap">
                    Explore Full 38-Item Menu <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </section>

