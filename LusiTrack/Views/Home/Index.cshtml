                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Luxury Roaster Subscription Banner -->
<section class="container mb-5 pb-3">
    <div class="card text-white rounded-4 p-4 p-md-5 shadow-lg border-0" 
         style="background: radial-gradient(circle at 15% 25%, #3d2314 0%, #160d08 85%);">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small fw-bold mb-2">
                    <i class="bi bi-calendar-check me-1"></i> The Roastery Club
                </span>
                <h3 class="display-6 brand-font fw-bold mb-2 text-white">Never Run Out of Exceptional Coffee</h3>
                <p class="text-white-50 mb-3" style="max-width: 600px; line-height: 1.6;">
                    Subscribe to bi-weekly or monthly roasts. Enjoy 15% savings, complimentary priority shipping, and priority access to limited micro-lots before public release.
                </p>
                <div class="d-flex flex-wrap gap-3 text-white-50 small">
                    <span><i class="bi bi-check-lg text-warning me-1"></i> Modify or cancel anytime</span>
                    <span><i class="bi bi-check-lg text-warning me-1"></i> Custom grind for your machine</span>
                    <span><i class="bi bi-check-lg text-warning me-1"></i> Surprise reserve bean drops</span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-warning btn-lg fw-bold text-dark rounded-pill px-4 py-3 shadow">
                    Start Custom Subscription <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const slides = document.querySelectorAll('.hero-coffee-slide');
        const dots = document.querySelectorAll('.slider-dot');
        const prevBtn = document.getElementById('heroPrevBtn');
        const nextBtn = document.getElementById('heroNextBtn');
        const sliderWrap = document.querySelector('.hero-slider-wrap');
        
        if (!slides.length) return;

        let currentIndex = 0;
        let slideTimer = null;
        const intervalTime = 4500; // 4.5s per slide

        function showSlide(index) {
            if (index < 0) index = slides.length - 1;
            if (index >= slides.length) index = 0;

            slides.forEach((slide, i) => {
                slide.classList.toggle('active', i === index);
            });

            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
                const progress = dot.querySelector('.dot-progress');
                if (progress) {
                    // Reset animation
                    progress.style.animation = 'none';
                    progress.offsetHeight; // trigger reflow
                    if (i === index) {
                        progress.style.animation = 'progressFill ' + (intervalTime / 1000) + 's linear forwards';
                    }
                }
            });

            currentIndex = index;
        }

        function startAutoplay() {
            stopAutoplay();
            slideTimer = setInterval(() => {
                showSlide(currentIndex + 1);
            }, intervalTime);
        }

        function stopAutoplay() {
            if (slideTimer) {
                clearInterval(slideTimer);
                slideTimer = null;
            }
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                showSlide(currentIndex + 1);
                startAutoplay();
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                showSlide(currentIndex - 1);
                startAutoplay();
            });
        }

        dots.forEach((dot, idx) => {
            dot.addEventListener('click', (e) => {
                e.preventDefault();
                showSlide(idx);
                startAutoplay();
            });
        });

        // Pause autoplay on mouse enter, resume on mouse leave
        if (sliderWrap) {
            sliderWrap.addEventListener('mouseenter', stopAutoplay);
            sliderWrap.addEventListener('mouseleave', startAutoplay);
        }

        // Start initial cycle
        showSlide(0);
        startAutoplay();
    });
</script>
}
