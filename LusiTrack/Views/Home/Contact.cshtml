@{
    ViewData["Title"] = "Visit Our Roastery & Contact Us";
}

<!-- Contact Hero -->
<div class="py-5 text-white" style="background: radial-gradient(circle at 60% 40%, #3a2215 0%, #140d08 100%); border-bottom: 1px solid rgba(219, 162, 100, 0.2);">
    <div class="container text-center py-4">
        <span class="hero-badge mb-3">
            <i class="bi bi-geo-alt-fill text-warning"></i> Flagship Roastery Bar
        </span>
        <h1 class="display-4 brand-font fw-bold mb-3 text-white">Visit Us or Connect</h1>
        <p class="lead text-white-50 max-w-700 mx-auto" style="font-size: 1.15rem; line-height: 1.7;">
            Step up to our slow-pour brew bar for a single-origin tasting flight, or reach out regarding wholesale partnerships and subscriptions.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Roastery Details Column -->
        <div class="col-lg-5">
            <div class="mb-4">
                <span class="badge bg-warning bg-opacity-20 text-dark px-3 py-1 rounded-pill small fw-bold mb-2">
                    Specialty Coffee District
                </span>
                <h2 class="brand-font fw-bold mb-3">Our Flagship Location</h2>
                <p class="text-secondary" style="line-height: 1.7;">
                    Located in the heart of the artisan district. Watch our cast-iron roaster in action through glass partitions while our baristas dial in the day's harvest.
                </p>
            </div>

            <!-- Address Card -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border mb-3 shadow-sm">
                <div class="brand-icon-wrap" style="width: 44px; height: 44px; flex-shrink: 0;">
                    <i class="bi bi-geo-alt-fill text-dark"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Roastery & Espresso Bar</h6>
                    <p class="text-muted small mb-0">104 Artisanal Way, Specialty Coffee District</p>
                    <small class="text-warning fw-semibold">Corner of 4th & Heritage Ave • Ample Street Parking</small>
                </div>
            </div>

            <!-- Email Card -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border mb-3 shadow-sm">
                <div class="brand-icon-wrap" style="width: 44px; height: 44px; flex-shrink: 0;">
                    <i class="bi bi-envelope-fill text-dark"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Email Support & Wholesale</h6>
                    <p class="text-muted small mb-0">hello@lusitrackcoffee.com</p>
                    <small class="text-muted">Response within 12 business hours</small>
                </div>
            </div>

            <!-- Brewing Hours Card (Deduplicated & Clean) -->
            <div class="d-flex align-items-start gap-3 p-3 bg-white rounded-3 border mb-3 shadow-sm">
                <div class="brand-icon-wrap" style="width: 44px; height: 44px; flex-shrink: 0;">
                    <i class="bi bi-clock-fill text-dark"></i>
                </div>
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="fw-bold mb-0 text-dark">Brewing Hours</h6>
                        <span class="open-status-badge">
                            <span class="open-status-dot"></span> Open
                        </span>
                    </div>
                    <div class="small text-muted">
                        <div><strong>Monday – Friday:</strong> 6:30 AM – 7:00 PM</div>
                        <div><strong>Saturday – Sunday:</strong> 7:30 AM – 6:00 PM</div>
                    </div>
                </div>
            </div>

            <!-- Cafe Amenities -->
            <div class="p-3 rounded-3 mt-4" style="background-color: var(--coffee-cream-100); border: 1px solid var(--coffee-border);">
                <h6 class="fw-bold small text-dark text-uppercase mb-2" style="letter-spacing: 0.05em;">Roastery Amenities</h6>
                <div class="d-flex flex-wrap gap-2 small text-secondary">
                    <span class="badge bg-white border text-dark p-2"><i class="bi bi-cup-hot text-warning me-1"></i> Pour-Over Flights</span>
                    <span class="badge bg-white border text-dark p-2"><i class="bi bi-wifi text-warning me-1"></i> High-Speed Wi-Fi</span>
                    <span class="badge bg-white border text-dark p-2"><i class="bi bi-gear text-warning me-1"></i> Custom Grinding Bar</span>
                    <span class="badge bg-white border text-dark p-2"><i class="bi bi-sun text-warning me-1"></i> Dog-Friendly Patio</span>
                </div>
            </div>
        </div>

        <!-- Contact Form Column -->
        <div class="col-lg-7">
            <div class="card p-4 p-md-5 rounded-4 shadow-sm border-0 bg-white">
                <h3 class="brand-font fw-bold mb-2">Send Our Roasters a Note</h3>
                <p class="text-muted small mb-4">
                    Whether you have questions about our extraction ratios, want to order whole beans in bulk, or simply want to say hello.
                </p>

                <form onsubmit="event.preventDefault(); alert('Thank you! Your message has been routed to our roastery team.');">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Your Name</label>
                            <input type="text" class="form-control" placeholder="e.g. Seth Andrey" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Your Email</label>
                            <input type="email" class="form-control" placeholder="seth@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Topic of Inquiry</label>
                            <select class="form-select">
                                <option selected>General Inquiry & Sourcing</option>
                                <option>Wholesale & Cafe Accounts</option>
                                <option>Brew Club Subscription Help</option>
                                <option>Private Cupping & Roastery Tour</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Message</label>
                            <textarea class="form-control" rows="4" 
                                      placeholder="How can our team assist your coffee journey?" required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn-coffee-primary px-4 py-2">
                                Send Message <i class="bi bi-send-fill ms-1"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
