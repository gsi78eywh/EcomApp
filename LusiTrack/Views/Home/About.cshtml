@{
    ViewData["Title"] = "Our Coffee Story";
}

<div class="container py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-warning text-dark px-3 py-2 text-uppercase fw-bold mb-3 rounded-pill">
                Passionate Craftsmanship
            </span>
            <h1 class="display-4 fw-bold brand-font mb-4">Born from a Love of Specialty Roasting</h1>
            <p class="lead text-muted mb-4">
                At LusiTrack Coffee Roasters, we believe that coffee is more than just caffeine—it's an artisanal ritual, a bridge between cultures, and a sensory craft.
            </p>
            <p class="text-secondary">
                Founded in 2024, our roastery partners directly with smallholder coffee farmers across Ethiopia, Colombia, Guatemala, and Sumatra. We pay above Fair Trade prices to foster sustainable farming practices and support local harvest communities.
            </p>
            <div class="row g-3 mt-3">
                <div class="col-sm-6">
                    <div class="border-start border-warning border-4 ps-3">
                        <h4 class="fw-bold mb-1">100% Arabica</h4>
                        <p class="text-muted small mb-0">High-altitude specialty beans only</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="border-start border-warning border-4 ps-3">
                        <h4 class="fw-bold mb-1">Freshly Roasted</h4>
                        <p class="text-muted small mb-0">Shipped within 48 hours of roast</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=700&q=80" 
                 alt="Coffee Roasting Process" class="img-fluid rounded-4 shadow-lg" />
        </div>
    </div>
</div>
