@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Operations & Admin Portal | JMT CAFE Dalaguete";
}

@section Scripts {
    <!-- Leaflet Interactive Maps CSS & JS for Admin Fleet Radar -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        let adminMap, adminCourierMarker;
        const roasteryPos = [9.7848734, 123.4460781]; // JMT CAFE Purok 5 Tabon
        const customerPos = [9.7618, 123.4682]; // Poblacion Dalaguete
        let riderPos = [9.7730, 123.4560];

        const adminRouteWaypoints = [
            roasteryPos,
            [9.7820, 123.4485],
            [9.7790, 123.4510],
            [9.7760, 123.4535],
            [9.7730, 123.4560],
            [9.7690, 123.4600],
            [9.7650, 123.4640],
            customerPos
        ];

        function initAdminFleetMap() {
            const mapEl = document.getElementById('adminFleetMap');
            if (!mapEl) return;

            adminMap = L.map('adminFleetMap', {
                zoomControl: true,
                scrollWheelZoom: false
            }).setView(riderPos, 13);

            // Free OpenStreetMap Standard Tiles (No API Key required, no watermark)
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(adminMap);

            // 1. JMT Cafe Hub Pin
            const hubIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `
                    <div class="location-marker-pin roastery-pin shadow" title="JMT CAFE Dalaguete Hub">
                        <i class="bi bi-cup-hot-fill text-warning"></i>
                    </div>
                `,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });
            L.marker(roasteryPos, { icon: hubIcon }).addTo(adminMap)
                .bindPopup("<strong>JMT CAFE Dalaguete</strong><br>Purok 5 Tabon, Dalaguete, 6022 Cebu<br><small class='text-muted'>Main Kitchen & Dispatch Center</small>");

            // 2. Customer Destination Pin
            const destIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `
                    <div class="location-marker-pin customer-pin shadow" title="Destination">
                        <i class="bi bi-house-door-fill text-white"></i>
                    </div>
                `,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });
            L.marker(customerPos, { icon: destIcon }).addTo(adminMap)
                .bindPopup("<strong>Order JMT-2026-00124 Destination</strong><br>Poblacion, Dalaguete, 6022 Cebu<br><small class='text-success fw-bold'>Pre-Paid via GCash • Highland Priority</small>");

            // 3. Route Polyline
            L.polyline(adminRouteWaypoints, {
                color: '#d4a373',
                weight: 5,
                opacity: 0.85
            }).addTo(adminMap);

            // 4. Courier Motorcycle Marker with Radar Wave
            const courierIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `
                    <div class="courier-marker-container">
                        <div class="courier-pulse-ring"></div>
                        <div class="courier-marker-badge moving">
                            <i class="bi bi-bicycle"></i>
                        </div>
                    </div>
                `,
                iconSize: [46, 46],
                iconAnchor: [23, 23]
            });

            adminCourierMarker = L.marker(riderPos, { icon: courierIcon }).addTo(adminMap);
            adminCourierMarker.bindPopup("<strong>Kuya Junrey D. (Dalaguete Rider)</strong><br>Honda Click 125i • Plate <strong>7G-8821</strong><br>Carrying: Order <strong>JMT-2026-00124</strong><br>Speed: <strong>32 km/h</strong> &bull; GPS Signal: <strong>Strong (4G)</strong>");

            adminMap.fitBounds(L.polyline(adminRouteWaypoints).getBounds(), { padding: [30, 30] });

            // Simulate minor live GPS ping updates
            setInterval(() => {
                const latJitter = (Math.random() - 0.5) * 0.0003;
                const lngJitter = (Math.random() - 0.5) * 0.0003;
                riderPos = [riderPos[0] + latJitter, riderPos[1] + lngJitter];
                adminCourierMarker.setLatLng(riderPos);
            }, 3000);
        }

        function recenterAdminRider() {
            if (!adminMap || !adminCourierMarker) return;
            adminMap.setView(adminCourierMarker.getLatLng(), 15, { animate: true });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initAdminFleetMap();
        });
    </script>
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Header Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" 
                 style="background: rgba(212, 163, 115, 0.15); border: 1px solid rgba(212, 163, 115, 0.35);">
                <i class="bi bi-shield-check text-warning"></i>
                <span class="text-warning small fw-bold text-uppercase" style="letter-spacing: 0.08em;">JMT CAFE Operations & Fleet Control</span>
            </div>
            <h1 class="brand-font display-6 fw-bold mb-0">JMT CAFE Business Dashboard</h1>
            <p class="text-muted small mb-0">Real-time inquiries, local dispatch queue, and menu inventory stock management for JMT CAFE Dalaguete.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm px-3 fw-semibold">
                <i class="bi bi-eye me-1"></i> View Live Store
            </a>
            <button class="btn btn-gold rounded-pill btn-sm px-3 fw-bold" onclick="window.location.reload();">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
            <form method="post" asp-action="Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill btn-sm px-3 fw-semibold">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert" style="background: #eef9f1; color: #1e6b36;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert" style="background: #fdf2f2; color: #a92020;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Today's Revenue</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">₱@Model.TodayRevenue.ToString("N2")</h3>
                        <small class="text-primary fw-semibold"><i class="bi bi-shield-check me-1"></i>100% Pre-Paid (GCash Only)</small>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle fs-3 shadow-sm">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Total Orders Today</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOrdersToday</h3>
                        <small class="text-muted">Zero Failed Deliveries / Zero RTS</small>
                    </div>
                    <div class="p-3 rounded-circle fs-3 shadow-sm" style="background: rgba(41, 24, 14, 0.08); color: var(--coffee-900);">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Couriers on Road</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">1 Live Courier</h3>
                        <small class="text-muted">Kuya Junrey &bull; Dalaguete Rd</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle fs-3 shadow-sm">
                        <i class="bi bi-bicycle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Low Stock Lots</span>
                        <h3 class="fw-bold text-danger mb-0 mt-1">@Model.LowStockItemsCount</h3>
                        <small class="text-muted">&lt; 10 units in cafe inventory</small>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle fs-3 shadow-sm">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- ADMIN LIVE COURIER FLEET & GPS DISPATCH RADAR                   -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                <h5 class="brand-font fw-bold mb-0">
                    <i class="bi bi-broadcast text-warning me-1"></i> Admin Live Fleet GPS Radar &bull; Delivery Location Tracking
                </h5>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-1 rounded-pill small">
                    <i class="bi bi-shield-lock-fill me-1"></i> GCash Pre-Paid Protected (No RTS Losses)
                </span>
                <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3" onclick="recenterAdminRider()">
                    <i class="bi bi-crosshair me-1"></i> Focus Active Courier
                </button>
            </div>
        </div>

        <div class="p-3">
            <div class="row g-3">
                <!-- Map View -->
                <div class="col-lg-8">
                    <div class="rounded-4 overflow-hidden border shadow-sm position-relative" style="height: 380px;">
                        <div id="adminFleetMap" style="width: 100%; height: 100%;"></div>
                    </div>
                </div>

                <!-- Active Courier Card Sidebar -->
                <div class="col-lg-4">
                    <div class="p-3 bg-light rounded-4 border h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-success text-white px-2 py-1 rounded-pill small fw-bold">
                                    <i class="bi bi-broadcast me-1"></i> GPS Live Ping
                                </span>
                                <small class="text-muted font-monospace">Order #JMT-2026-00124</small>
                            </div>

                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" 
                                     alt="Courier Photo" class="rounded-circle shadow-sm" style="width: 54px; height: 54px; object-fit: cover; border: 2px solid var(--gold-500);" />
                                <div>
                                    <h6 class="fw-bold mb-0">Junrey "Kuya Jun" D.</h6>
                                    <div class="small text-secondary">
                                        <i class="bi bi-bicycle text-warning me-1"></i>Honda Click 125i (Silver/Black)
                                    </div>
                                    <div class="small text-muted font-monospace">Plate: <strong>7G-8821</strong> &bull; 4.95 ★</div>
                                </div>
                            </div>

                            <div class="p-2 bg-white rounded-3 border mb-3 small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Current Street:</span>
                                    <span class="fw-bold text-dark">Dalaguete Mountain Rd (Tabon)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Heading To:</span>
                                    <span class="fw-bold text-dark">Poblacion Heritage Plaza, Dalaguete</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Destination ETA:</span>
                                    <span class="fw-bold text-success">~8 mins (1.6 km left)</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Courier Speed:</span>
                                    <span class="fw-bold text-primary">36 km/h</span>
                                </div>
                            </div>

                            <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary small mb-3">
                                <i class="bi bi-patch-check-fill me-1"></i>
                                <strong>Payment Verified:</strong> ₱430.00 settled via GCash (Ref #983281). Safe for immediate gate drop-off!
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="tel:+639178821940" class="btn btn-outline-dark btn-sm rounded-pill flex-fill fw-semibold">
                                <i class="bi bi-telephone me-1"></i> Call Courier
                            </a>
                            <a asp-controller="Order" asp-action="Track" asp-route-orderId="JMT-2026-00124" target="_blank" class="btn btn-gold btn-sm rounded-pill flex-fill fw-bold">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Client Track View
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Operational Panels -->
    <div class="row g-4">
        <!-- Live Order Queue Table -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="brand-font fw-bold mb-0">
                        <i class="bi bi-activity text-warning me-2"></i> Live Order Fulfillment Queue
                    </h5>
                    <span class="badge bg-light text-dark border fw-semibold">@Model.RecentOrders.Count Active Orders</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Order ID & Time</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Payment Mode</th>
                                <th scope="col">Total</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="pe-4 text-end">Fulfillment Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentOrders.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No orders in the system yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <a asp-controller="Order" asp-action="Track" asp-route-orderId="@order.OrderId" class="fw-bold font-monospace text-dark text-decoration-none">
                                                @order.OrderId
                                            </a>
                                            <small class="text-muted d-block">@order.OrderDate.ToString("hh:mm tt • MMM dd")</small>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@order.CustomerName</div>
                                            <small class="text-muted">@order.Phone</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 rounded-pill">
                                                <i class="bi bi-wallet2 me-1"></i>GCash Verified
                                            </span>
                                            @if (order.FulfillmentType == "Delivery")
                                            {
                                                <small class="text-muted d-block mt-1"><i class="bi bi-truck me-1"></i>Delivery</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted d-block mt-1"><i class="bi bi-shop me-1"></i>Bar Pickup</small>
                                            }
                                        </td>
                                        <td class="fw-bold text-success">₱@order.TotalAmount.ToString("N2")</td>
                                        <td>
                                            @{
                                                var badgeClass = order.OrderStatus switch
                                                {
                                                    "Completed" => "bg-success text-white",
                                                    "OutForDelivery" => "bg-primary text-white",
                                                    "Ready" => "bg-info text-dark",
                                                    _ => "bg-warning text-dark"
                                                };
                                            }
                                            <span class="badge @badgeClass px-2 py-1">@order.OrderStatus</span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <div class="d-inline-flex gap-2 align-items-center">
                                                @if (order.FulfillmentType == "Delivery")
                                                {
                                                    <a asp-controller="Order" asp-action="Track" asp-route-orderId="@order.OrderId" class="btn btn-outline-warning btn-sm rounded-pill px-2 fw-semibold" title="Track Live Delivery Rider on Map">
                                                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> Live Map
                                                    </a>
                                                }
                                                <form asp-action="UpdateOrderStatus" method="post" class="d-inline-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                    <select name="newStatus" class="form-select form-select-sm rounded-pill" style="width: 135px;" onchange="this.form.submit()">
                                                        <option value="Preparing" selected="@(order.OrderStatus == "Preparing")">Preparing</option>
                                                        <option value="Ready" selected="@(order.OrderStatus == "Ready")">Ready</option>
                                                        <option value="OutForDelivery" selected="@(order.OrderStatus == "OutForDelivery")">Out for Deliv.</option>
                                                        <option value="Completed" selected="@(order.OrderStatus == "Completed")">Completed</option>
                                                    </select>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Product Inventory & Stock Management -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="brand-font fw-bold mb-0">
                        <i class="bi bi-boxes text-warning me-2"></i> Inventory & Bean Lots Management
                    </h5>
                    <span class="badge bg-light text-dark border fw-semibold">@Model.AllProducts.Count Products</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Product</th>
                                <th scope="col">Category</th>
                                <th scope="col">Price</th>
                                <th scope="col" class="text-center">Stock</th>
                                <th scope="col" class="text-center">Status</th>
                                <th scope="col" class="pe-4 text-end">Stock Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in Model.AllProducts)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@prod.ImageUrl" alt="@prod.Name" class="rounded-2 shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" />
                                            <div>
                                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@prod.Id" class="fw-semibold text-dark text-decoration-none">
                                                    @prod.Name
                                                </a>
                                                <small class="text-muted d-block">ID #@prod.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-secondary border">@prod.Category</span></td>
                                    <td class="fw-bold text-success">₱@prod.Price.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (prod.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-danger">@prod.StockQuantity units</span>
                                        }
                                        else if (prod.StockQuantity <= 10)
                                        {
                                            <span class="badge bg-warning text-dark">@prod.StockQuantity units</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@prod.StockQuantity units</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (prod.IsInStock)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Sold Out</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="RestockProduct" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@prod.Id" />
                                                <input type="hidden" name="quantity" value="25" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Restock +25 units">
                                                    <i class="bi bi-plus-lg"></i> 25
                                                </button>
                                            </form>
                                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@prod.Id" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Toggle active status">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar: Low Stock Alerts & Anti-RTS Policy Guide -->
        <div class="col-xl-4">
            <!-- Anti-RTS Pre-Paid Policy Card (60-30-10 Warm Neutral) -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: #FFFDF9; border: 1.5px solid rgba(212, 163, 115, 0.45) !important;">
                <h6 class="fw-bold text-dark mb-2">
                    <i class="bi bi-shield-check text-warning me-1"></i> Pre-Paid GCash Policy (Anti-RTS)
                </h6>
                <p class="small text-secondary mb-2" style="line-height: 1.6;">
                    Cash on Delivery is intentionally disabled across the store. Because specialty coffee drinks and fresh drum roasts perish if unreceived, 100% upfront GCash payment eliminates bogus buyers and Return-To-Sender losses.
                </p>
                <div class="small text-dark fw-semibold">
                    <i class="bi bi-check2-circle text-success me-1"></i> 100% Successful Delivery Handover
                </div>
            </div>

            <!-- Low Stock Warnings -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="brand-font fw-bold mb-3 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Low Stock Alerts
                </h5>
                @if (!Model.LowStockProducts.Any())
                {
                    <p class="text-muted small mb-0">All bean lots and bakery products are currently well-stocked!</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var low in Model.LowStockProducts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                                <div>
                                    <strong class="d-block small">@low.Name</strong>
                                    <small class="text-danger">Only @low.StockQuantity remaining</small>
                                </div>
                                <form asp-action="RestockProduct" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@low.Id" />
                                    <input type="hidden" name="quantity" value="30" />
                                    <button type="submit" class="btn btn-gold btn-sm py-1 px-3 fw-semibold">
                                        Restock +30
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Operations Guide -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="brand-font fw-bold mb-3">Staff Operations Guide</h5>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bi bi-dot text-warning fs-5"></i> <strong>Preparing:</strong> Roast and espresso extraction underway.</li>
                    <li class="mb-2"><i class="bi bi-dot text-info fs-5"></i> <strong>Ready:</strong> Product boxed and waiting for driver or customer pickup.</li>
                    <li class="mb-2"><i class="bi bi-dot text-primary fs-5"></i> <strong>Out for Delivery:</strong> Maxim express courier is on the road; live GPS radar active above.</li>
                    <li><i class="bi bi-dot text-success fs-5"></i> <strong>Completed:</strong> Delivered or picked up; inventory automatically decremented.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
