@using LusiTrack.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @JmtCafeConfig.Name Dalaguete Cebu</title>
    <meta name="description" content="JMT CAFE located at @JmtCafeConfig.FullAddress. Savor our famous 10-inch party burger, crispy chicken meals with signature drinks, flame-grilled burger combos, handcrafted fruit mojitos, and authentic barista coffee." />
    <meta name="keywords" content="JMT Cafe, Dalaguete cafe, Purok 5 Tabon, Bisayang Explorer TV, Cebu food trip, Dalaguete chicken meal, Dalaguete burger, Cebu coffee shop, Osmeña Peak stopover" />
    <meta name="theme-color" content="#231709" />

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content="@ViewData["Title"] - @JmtCafeConfig.Name Dalaguete" />
    <meta property="og:description" content="Handcrafted coffee, fruit mojitos from ₱35, crispy chicken meals from ₱79, and giant 10-inch burgers at @JmtCafeConfig.FullAddress." />
    <meta property="og:image" content="~/images/jmt/jmt_storefront_highlands.jpg" />
    <meta property="og:url" content="https://jmtcafe.ph" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - @JmtCafeConfig.Name" />
    <meta name="twitter:description" content="Dalaguete's premier food and coffee spot in Purok 5 Tabon, Cebu." />
    <meta name="twitter:image" content="~/images/jmt/jmt_storefront_highlands.jpg" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="apple-touch-icon" href="~/favicon.svg" />
    <link rel="manifest" href="~/site.webmanifest" />
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />

    <!-- JSON-LD Structured Data for Local Business / Restaurant SEO -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "CafeOrCoffeeShop",
      "name": "@JmtCafeConfig.Name",
      "description": "Artisan coffee, fresh fruit mojitos, giant burgers, and chicken meals in the scenic highlands of Dalaguete, Cebu.",
      "image": "/images/jmt/jmt_storefront_highlands.jpg",
      "telephone": "@JmtCafeConfig.PhoneInternational",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "@JmtCafeConfig.AddressLine1",
        "addressLocality": "@JmtCafeConfig.Municipality",
        "addressRegion": "@JmtCafeConfig.Province",
        "postalCode": "@JmtCafeConfig.PostalCode",
        "addressCountry": "PH"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": @JmtCafeConfig.Latitude,
        "longitude": @JmtCafeConfig.Longitude
      },
      "url": "https://jmtcafe.ph",
      "openingHoursSpecification": {
        "@@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ],
        "opens": "09:00",
        "closes": "22:00"
      },
      "priceRange": "₱35 - ₱879",
      "servesCuisine": ["Filipino", "Comfort Food", "Burgers", "Coffee", "Shakes"],
      "sameAs": [
        "@JmtCafeConfig.FacebookPageUrl",
        "@JmtCafeConfig.BisayangExplorerUrl"
      ]
    }
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Reading Scroll Progress Bar -->
    <div id="scrollProgressBar" aria-hidden="true"></div>

    <!-- Top Announcement Bar: Clean, compact dual-metric bar -->
    <div class="announcement-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center flex-nowrap">
            <div class="text-truncate me-3 d-flex align-items-center gap-2">
                <span class="text-warning fw-semibold"><i class="bi bi-clock-history me-1"></i> Open Daily: @JmtCafeConfig.HoursDisplay • @JmtCafeConfig.AddressLine1, @JmtCafeConfig.Municipality</span>
            </div>
            <div class="d-flex gap-3 align-items-center flex-shrink-0 text-nowrap">
                <!-- Dynamic Real-Time Cafe Operating Status Widget -->
                <span id="liveCafeStatusPill" class="live-status-pill">
                    <span class="live-beacon-dot"></span>
                    <span id="liveStatusText">OPEN NOW • Closes 10 PM</span>
                </span>
                <span class="opacity-50">|</span>
                <a href="@JmtCafeConfig.PhoneTelLink" class="text-light text-decoration-none small">
                    <i class="bi bi-telephone-fill text-warning me-1"></i> @JmtCafeConfig.PhoneDisplay
                </a>
                <span class="opacity-50">|</span>
                <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="text-warning text-decoration-none fw-semibold">
                    <i class="bi bi-facebook me-1"></i> Official Facebook
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-coffee py-3">
            <div class="container">
                <!-- Brand Emblem with subtle coffee steam animation -->
                <a class="navbar-brand brand-font" href="/">
                    <i class="bi bi-cup-hot-fill text-warning fs-3 coffee-steam-fx"></i>
                    <span class="d-flex flex-column lh-1">
                        <span class="fw-bold tracking-tight">@JmtCafeConfig.Name</span>
                        <span class="brand-badge text-uppercase mt-1" style="letter-spacing: 0.12em;">@JmtCafeConfig.AddressLine1, @JmtCafeConfig.Municipality</span>
                    </span>
                </a>

                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                               href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shop" ? "active" : "")" 
                               href="/menu">Food & Drinks Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")" 
                               href="/about">Our Story</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")" 
                               href="/contact">
                                <i class="bi bi-geo-alt-fill text-warning me-1"></i> Find Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Franchise" ? "active" : "")" 
                               href="/franchise">Events & Catering</a>
                        </li>
                    </ul>

                    <!-- Action Controls: Visit Us & Inquire on Facebook -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-outline-warning btn-sm rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-pin-map-fill text-warning"></i>
                            <span>Visit Our Cafe</span>
                        </a>
                        <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-warning btn-sm rounded-pill fw-bold text-dark px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-facebook fs-6"></i>
                            <span class="d-none d-xl-inline">Inquire on</span> Facebook
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast Alerts from TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 shadow-sm rounded-4 border-0 p-3" role="alert" style="background: #eef9f1; color: #1e6b36;">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Toast Notification Container for Instant Feedback -->
    <div id="cartToastContainer"></div>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Floating Visit JMT Cafe & Directions Pill (Desktop & Tablet) -->
    <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" 
       class="floating-visit-btn d-none d-md-flex" aria-label="Visit JMT Cafe in Tabon, Dalaguete &bull; Get Directions">
        <i class="bi bi-pin-map-fill fs-5 text-warning"></i>
        <div class="d-flex flex-column text-start lh-1">
            <span class="fw-bold text-white">Visit JMT Cafe</span>
            <small class="text-warning opacity-90 mt-1" style="font-size: 0.72rem;">Tabon, Dalaguete &bull; Open 9AM–10PM</small>
        </div>
    </a>

    <!-- Mobile Sticky Action Bar (Fixed to bottom on mobile devices) -->
    <div class="mobile-sticky-action-bar d-md-none" role="navigation" aria-label="Quick Mobile Actions">
        <a href="@JmtCafeConfig.PhoneTelLink" class="mobile-bar-btn" aria-label="Call JMT Cafe">
            <i class="bi bi-telephone-fill text-success"></i>
            <span>Call</span>
        </a>
        <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="mobile-bar-btn" aria-label="Visit JMT Cafe on Google Maps">
            <i class="bi bi-geo-alt-fill text-danger"></i>
            <span>Visit Us</span>
        </a>
        <a href="/menu" class="mobile-bar-btn" aria-label="Browse Food & Drinks Menu">
            <i class="bi bi-book-half text-warning"></i>
            <span>Menu</span>
        </a>
        <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="mobile-bar-btn" aria-label="Inquire on Official Facebook">
            <i class="bi bi-facebook text-primary"></i>
            <span>Inquire</span>
        </a>
    </div>

    <!-- Luxury Multi-Column Footer -->
    <footer class="footer-luxury py-5 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Column 1: Brand & Philosophy -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-cup-hot-fill text-warning fs-3"></i>
                        <span class="brand-font fs-4 fw-bold text-white">@JmtCafeConfig.Name</span>
                    </div>
                    <p class="small text-secondary mb-3 pe-lg-4" style="color: #b0a49d !important; line-height: 1.7;">
                        Dalaguete's welcoming comfort food and drink destination in Southern Cebu. Serving signature 10-inch celebration burgers, crispy chicken meals, French fries, decadent frappes, handcrafted barista coffee, and refreshing fruit coolers.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="text-white-50 hover-gold" aria-label="Official JMT Cafe Facebook Page" title="Official JMT Cafe Facebook Page"><i class="bi bi-facebook"></i></a>
                        <a href="@JmtCafeConfig.BisayangExplorerUrl" target="_blank" rel="noopener noreferrer" class="text-white-50 hover-gold" aria-label="Bisayang Explorer TV Feature Video" title="Bisayang Explorer TV Feature"><i class="bi bi-play-circle-fill"></i></a>
                        <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="text-white-50 hover-gold" aria-label="View Location on Google Maps" title="Location on Google Maps"><i class="bi bi-geo-alt-fill"></i></a>
                        <a href="@JmtCafeConfig.PhoneTelLink" class="text-white-50 hover-gold" aria-label="Call JMT Cafe Phone" title="Call Cafe"><i class="bi bi-telephone-fill"></i></a>
                    </div>
                </div>

                <!-- Column 2: JMT Cafe Menu Highlights -->
                <div class="col-lg-3 col-6">
                    <div class="footer-heading">Menu Highlights</div>
                    <ul class="list-unstyled">
                        <li><a href="/menu?category=Burgers+%26+Snacks" class="footer-link">Giant 10" JMT Burger (₱879)</a></li>
                        <li><a href="/menu?category=Burgers+%26+Snacks" class="footer-link">Bacon Burger Combo (₱170)</a></li>
                        <li><a href="/menu?category=Burgers+%26+Snacks" class="footer-link">Buy 1 Take 1 Classic Burger (₱65)</a></li>
                        <li><a href="/menu?category=Silog+%26+Rice+Meals" class="footer-link">1-Pc Chicken Meal w/ Drink (₱135)</a></li>
                        <li><a href="/menu?category=Mojito+Drinks" class="footer-link">Fresh Fruit Mojitos (From ₱35)</a></li>
                        <li><a href="/menu" class="footer-link text-warning fw-semibold">View All 38 Offerings →</a></li>
                    </ul>
                </div>

                <!-- Column 3: Visit & Connect -->
                <div class="col-lg-2 col-6">
                    <div class="footer-heading">Explore & Learn</div>
                    <ul class="list-unstyled">
                        <li><a href="/contact" class="footer-link text-warning fw-semibold"><i class="bi bi-geo-alt me-1"></i> Map & Directions</a></li>
                        <li><a href="/about" class="footer-link">Our Cafe & Story</a></li>
                        <li><a href="/franchise" class="footer-link">Events & Catering</a></li>
                        <li><a href="/privacy" class="footer-link">Privacy Statement</a></li>
                        <li><a href="@JmtCafeConfig.PhoneTelLink" class="footer-link text-warning"><i class="bi bi-telephone me-1"></i> @JmtCafeConfig.PhoneDisplay</a></li>
                    </ul>
                </div>

                <!-- Column 4: Location & Service -->
                <div class="col-lg-3 col-md-6">
                    <div class="footer-heading">Location & Service</div>
                    <div class="small text-secondary mb-3" style="color: #b0a49d !important; line-height: 1.6;">
                        <div class="text-white fw-bold"><i class="bi bi-pin-map-fill text-warning me-1"></i> @JmtCafeConfig.FullAddress</div>
                        <div class="mt-1 text-white-50">Landmark: @JmtCafeConfig.Landmark</div>
                        <div class="mt-2"><i class="bi bi-telephone text-warning me-1"></i> Mobile: <strong>@JmtCafeConfig.PhoneDisplay</strong></div>
                        <div class="mt-1"><i class="bi bi-clock text-warning me-1"></i> <strong>@JmtCafeConfig.HoursDisplay</strong></div>
                        <div class="mt-1"><i class="bi bi-bicycle text-warning me-1"></i> <strong>Delivery Available</strong> (Via Messenger)</div>
                        <div class="mt-1"><i class="bi bi-wind text-info me-1"></i> Fresh Mountain Breeze • Rooftop Deck</div>
                        <div class="mt-1"><i class="bi bi-wifi text-success me-1"></i> Free High-Speed Wi-Fi</div>
                    </div>
                    <a href="@JmtCafeConfig.GoogleMapsPlaceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark px-3 py-1">
                        <i class="bi bi-pin-map-fill me-1"></i> Open in Google Maps
                    </a>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4" />

            <!-- Bottom Legal Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary" style="color: #8c827b !important;">
                <div>
                    &copy; @DateTime.Now.Year @JmtCafeConfig.Name • @JmtCafeConfig.FullAddress • Tel: @JmtCafeConfig.PhoneDisplay
                </div>
                <div class="d-flex gap-3 mt-2 mt-sm-0">
                    <a href="/privacy" class="text-secondary text-decoration-none">Privacy Policy (RA 10173)</a>
                    <span>•</span>
                    <a href="/franchise" class="text-secondary text-decoration-none">Events & Catering</a>
                    <span>•</span>
                    <span>Open-Air Mountain Deck</span>
                    <span>•</span>
                    <span>Fresh Mountain Breeze</span>
                    <span>•</span>
                    <span>Free Wi-Fi</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Shared JMT Cafe Inquiry & Quick View Modal -->
    @await Html.PartialAsync("_JmtInquiryModal")

    <!-- Core Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ==========================================================================
        // Living UI Dynamic Interactions Engine
        // ==========================================================================

        // 1. Reading Scroll Progress Bar
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (height > 0) ? (winScroll / height) * 100 : 0;
            const bar = document.getElementById('scrollProgressBar');
            if (bar) bar.style.width = scrolled + '%';
        }, { passive: true });

        // 2. Real-Time Philippine Standard Time & Dynamic Cafe Operating Status
        function updateLiveOperatingStatus() {
            const now = new Date();
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const pht = new Date(utc + (3600000 * 8)); // UTC+8 Philippine Standard Time
            
            const hours = pht.getHours();
            const minutes = pht.getMinutes();
            // JMT Cafe Operating Hours: 9:00 AM (09:00) to 10:00 PM (22:00)
            const isOpen = (hours >= 9 && hours < 22);
            
            const pill = document.getElementById('liveCafeStatusPill');
            const text = document.getElementById('liveStatusText');
            const clock = document.getElementById('livePhtClock');

            if (pill && text) {
                if (isOpen) {
                    pill.className = 'live-status-pill';
                    text.innerText = 'OPEN NOW • Closes 10:00 PM';
                } else {
                    pill.className = 'live-status-pill closed';
                    text.innerText = 'OPENS 9:00 AM • Tabon Highlands';
                }
            }

            if (clock) {
                const ampm = hours >= 12 ? 'PM' : 'AM';
                const h12 = hours % 12 || 12;
                const minPad = minutes < 10 ? '0' + minutes : minutes;
                clock.innerHTML = `<i class="bi bi-clock-history text-warning me-1"></i>${h12}:${minPad} ${ampm} PHT`;
            }
        }

        // 3. Scroll Reveal Entrance Animations via IntersectionObserver
        document.addEventListener('DOMContentLoaded', () => {
            updateLiveOperatingStatus();
            setInterval(updateLiveOperatingStatus, 25000);

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-revealed');
                        }
                    });
                }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

                document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
            } else {
                document.querySelectorAll('.reveal-on-scroll').forEach(el => el.classList.add('is-revealed'));
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
