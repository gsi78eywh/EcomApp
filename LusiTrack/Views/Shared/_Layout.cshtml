@inject ICartService CartService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LusiTrack Artisanal Coffee Roasters</title>
    <meta name="description" content="Artisanal specialty coffee roasted in micro-batches. Single-origin Ethiopian, Colombian, and Sumatran beans delivered freshly to your doorstep." />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Custom Specialty Coffee Design System -->
    <link rel="stylesheet" href="~/app.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="announcement-bar text-center py-2">
        <div class="container d-flex justify-content-center align-items-center gap-2 flex-wrap">
            <span><i class="bi bi-fire text-warning me-1"></i> <strong>Micro-Roast Tuesday & Thursday:</strong> Orders dispatched within 48h of roasting</span>
            <span class="d-none d-md-inline opacity-50">✦</span>
            <span>Free express delivery on specialty orders over $35</span>
            <span class="d-none d-lg-inline opacity-50">✦</span>
            <a asp-controller="Shop" asp-action="Index" class="ms-1">Explore Harvests &rarr;</a>
        </div>
    </div>

    <!-- Luxury Sticky Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-coffee shadow-sm">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand brand-display" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-wrap">
                        <i class="bi bi-cup-hot-fill"></i>
                    </span>
                    <span>LUSITRACK <span class="fs-6 text-warning fw-normal brand-font">Roasters</span></span>
                </a>

                <!-- Mobile Hamburger Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Shop" ? "active" : "")" 
                               asp-controller="Shop" asp-action="Index">Reserve Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")" 
                               asp-controller="Home" asp-action="About">Our Roastery Story</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Contact" ? "active" : "")" 
                               asp-controller="Home" asp-action="Contact">Visit & Contact</a>
                        </li>
                    </ul>

                    <!-- Navbar Search Bar -->
                    <form asp-controller="Shop" asp-action="Index" method="get" class="d-flex align-items-center me-lg-3 my-2 my-lg-0 search-nav-form">
                        <div class="input-group input-group-sm search-nav-group w-100">
                            <span class="input-group-text bg-transparent border-0 text-warning ps-2 pe-1">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control form-control-sm search-nav-input" 
                                   placeholder="Search coffees..." 
                                   value="@(Context.Request.Query["search"].ToString())" 
                                   aria-label="Search coffees and menus" />
                            <button class="btn btn-sm btn-nav-search-btn" type="submit" title="Search Menu">
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Right Action / Cart & User -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="nav-link text-white-50 d-inline-flex align-items-center gap-1 px-2 py-1 @(currentController == "Account" ? "active text-warning" : "")" 
                           asp-controller="Account" asp-action="Login" title="Member Sign In">
                            <i class="bi bi-person-circle fs-5 text-warning"></i>
                            <span class="d-none d-sm-inline fw-semibold text-white">Sign In</span>
                        </a>

                        <a class="btn-nav-cart ms-1" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-bag-check-fill text-warning"></i>
                            <span>Cart</span>
                            @{
                                var cartCount = CartService.GetTotalItemCount();
                            }
                            @if (cartCount > 0)
                            {
                                <span class="cart-counter-badge">
                                    @cartCount
                                </span>
                            }
                        </a>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <!-- Global Toast Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-4">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 shadow-sm rounded-4 border-0 p-3 bg-white" 
                 role="alert" style="border-left: 5px solid #28a745 !important;">
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-inline-flex">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
                <div>
                    <strong class="text-dark d-block">Success</strong>
                    <span class="text-muted small">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-4">
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-3 shadow-sm rounded-4 border-0 p-3 bg-white" 
                 role="alert" style="border-left: 5px solid #dc3545 !important;">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 d-inline-flex">
                    <i class="bi bi-exclamation-octagon fs-4"></i>
                </div>
                <div>
                    <strong class="text-dark d-block">Notice</strong>
                    <span class="text-muted small">@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Dynamic Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Luxury Editorial Footer -->
    <footer class="footer-coffee">
        <div class="container">
            <div class="row g-5 mb-5">
                <!-- Roastery Story & Ethics -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon-wrap" style="width: 32px; height: 32px; font-size: 0.95rem;">
                            <i class="bi bi-cup-hot-fill"></i>
                        </span>
                        <h5 class="brand-display mb-0 text-white fs-4">LUSITRACK</h5>
                    </div>
                    <p class="small mb-3" style="line-height: 1.7;">
                        Obsessively sourcing top 1% specialty Arabica coffee from ethical farming collectives in Ethiopia, Colombia, Guatemala, and Sumatra. Hand-roasted in small 5kg drums for peak flavor nuance.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="open-status-badge">
                            <span class="open-status-dot"></span>
                            Roastery Bar Open Now
                        </span>
                        <span class="small text-white-50">Closes 7:00 PM</span>
                    </div>
                </div>

                <!-- Navigation Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3" style="letter-spacing: 0.08em;">Navigation</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Reserve Roasts</a></li>
                        <li><a asp-controller="Shop" asp-action="Index">Full Coffee Menu</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Shopping Bag</a></li>
                        <li><a asp-controller="Home" asp-action="About">Our Roasting Philosophy</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Find Our Cafe</a></li>
                    </ul>
                </div>

                <!-- Brew Bar Hours & Location -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3" style="letter-spacing: 0.08em;">Roastery Hours</h6>
                    <p class="small mb-1"><strong class="text-white">Monday – Friday:</strong> 6:30 AM – 7:00 PM</p>
                    <p class="small mb-2"><strong class="text-white">Saturday – Sunday:</strong> 7:30 AM – 6:00 PM</p>
                    <p class="small text-warning mb-0"><i class="bi bi-geo-alt-fill me-1"></i> 104 Artisanal Way, Specialty Coffee District</p>
                    <p class="small text-white-50 mt-1"><i class="bi bi-telephone me-1"></i> (555) 234-5874</p>
                </div>

                <!-- Brew Club VIP Signup Box -->
                <div class="col-lg-3 col-md-6">
                    <div class="footer-club-box">
                        <h6 class="text-white brand-font fw-bold mb-1">Join The Roaster's Guild</h6>
                        <p class="small text-white-50 mb-3">Get 10% off your first whole bean harvest & invitations to private cupping sessions.</p>
                        <form onsubmit="event.preventDefault(); alert('Welcome to the Roaster\'s Guild! Check your inbox for your 10% welcome code.');">
                            <div class="input-group input-group-sm mb-2">
                                <input type="email" class="form-control rounded-start-pill bg-dark border-secondary text-white" placeholder="Enter your email" required />
                                <button class="btn btn-warning rounded-end-pill px-3 fw-bold" type="submit">Join</button>
                            </div>
                        </form>
                        <span class="small text-white-50" style="font-size: 0.72rem;">Strict privacy. No spam. Only fresh roast dispatches.</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Legal & Payment Badges -->
            <hr class="border-secondary opacity-25 my-4" />
            <div class="d-flex flex-wrap justify-content-between align-items-center small gap-3">
                <span>&copy; @DateTime.Now.Year <strong>LusiTrack Coffee Roasters Ltd.</strong> Sourced with integrity, brewed with devotion.</span>
                <div class="d-flex align-items-center gap-3 text-white-50 fs-5">
                    <span title="Visa"><i class="bi bi-credit-card-2-front"></i></span>
                    <span title="Apple Pay"><i class="bi bi-apple"></i></span>
                    <span title="Fair Trade Coffee"><i class="bi bi-flower1 text-warning"></i></span>
                    <span title="Carbon Neutral"><i class="bi bi-globe-americas text-success"></i></span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
