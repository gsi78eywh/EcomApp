@inject ICartService CartService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LusiTrack Coffee Roasters</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/app.css" />
    <style>
        :root {
            --coffee-primary: #3d2314;
            --coffee-secondary: #c29979;
            --coffee-accent: #d48b52;
            --coffee-bg: #faf7f2;
            --coffee-dark: #20130b;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--coffee-bg);
            color: #2b2523;
        }
        h1, h2, h3, .brand-font {
            font-family: 'Playfair Display', serif;
        }
        .navbar-coffee {
            background-color: var(--coffee-dark);
            border-bottom: 2px solid var(--coffee-accent);
        }
        .btn-coffee {
            background-color: var(--coffee-accent);
            color: #fff;
            border-radius: 8px;
            font-weight: 600;
            padding: 8px 18px;
            transition: all 0.2s ease;
        }
        .btn-coffee:hover {
            background-color: #be753d;
            color: #fff;
        }
        .btn-outline-coffee {
            border: 2px solid var(--coffee-accent);
            color: var(--coffee-dark);
            border-radius: 8px;
            font-weight: 600;
        }
        .btn-outline-coffee:hover {
            background-color: var(--coffee-accent);
            color: #fff;
        }
        .card-coffee {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.06);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
            background-color: #fff;
        }
        .card-coffee:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(0,0,0,0.12);
        }
        .badge-roast {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 4px 8px;
            border-radius: 6px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-coffee sticky-top shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 brand-font fs-3" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cup-hot-fill text-warning"></i>
                    <span>LusiTrack <span class="fs-6 text-warning text-uppercase fw-bold">Coffee</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-semibold" asp-controller="Shop" asp-action="Index">Coffee Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="About">Our Story</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <a class="btn btn-outline-light position-relative px-3 py-2 rounded-pill" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-bag-heart-fill me-1 text-warning"></i>
                            <span class="fw-semibold">Cart</span>
                            @{
                                var cartCount = CartService.GetTotalItemCount();
                            }
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cartCount
                                </span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white-50 py-5 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white brand-font mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-cup-hot-fill text-warning"></i> LusiTrack Coffee
                    </h5>
                    <p class="small">
                        Artisanal specialty coffee roasted in small batches, delivered freshly to your doorstep. Experience the aroma and flavor of ethically sourced single-origin beans.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                        <li class="mb-2"><a asp-controller="Shop" asp-action="Index" class="text-white-50 text-decoration-none">Shop Menu</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none">Shopping Cart</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About" class="text-white-50 text-decoration-none">About Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Roastery Hours</h6>
                    <p class="small mb-1"><strong class="text-white">Mon – Fri:</strong> 6:30 AM – 7:00 PM</p>
                    <p class="small mb-1"><strong class="text-white">Sat – Sun:</strong> 7:30 AM – 6:00 PM</p>
                    <p class="small text-warning"><i class="bi bi-geo-alt-fill"></i> Specialty Coffee District</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase small fw-bold mb-3">Stay Connected</h6>
                    <p class="small">Get 10% off your first coffee order by joining our brew club.</p>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Your email address" />
                        <button class="btn btn-warning fw-semibold" type="button">Join</button>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25" />
            <div class="d-flex flex-wrap justify-content-between align-items-center small">
                <span>&copy; @DateTime.Now.Year LusiTrack Coffee Roasters. All rights reserved.</span>
                <span>Crafted with ASP.NET Core (.NET 10 MVC)</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
