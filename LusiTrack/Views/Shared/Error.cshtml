@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="text-danger display-4 brand-font">Oops!</h1>
    <h2 class="text-danger mb-4">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-coffee mt-3">
        <i class="bi bi-house-door-fill me-1"></i> Return Home
    </a>
</div>
