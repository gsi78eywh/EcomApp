@using LusiTrack.Services
@using LusiTrack.Models
@model IEnumerable<CoffeeProduct>
@{
    ViewData["Title"] = "Food & Drinks Menu | JMT CAFE Dalaguete";
    var categories = ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "recommended";
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count();
    var allCount = ViewBag.AllProductsCount as int? ?? 42;
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var categoryDefs = ViewBag.CategoryDefinitions as IReadOnlyList<MenuCategoryModel> ?? JmtCafeConfig.CategoryDefinitions;
    var isCategorizedView = (selectedCategory == "All" && string.IsNullOrEmpty(searchQuery));
    var allProductsList = (ViewBag.AllProducts as IEnumerable<CoffeeProduct>)?.ToList() 
                          ?? (Model as IEnumerable<CoffeeProduct>)?.ToList() 
                          ?? new List<CoffeeProduct>();
    var fbPhotoProducts = allProductsList.Where(p => !string.IsNullOrEmpty(p.ImageUrl)).ToList();
}

@functions {
    public static string GetShowcaseTheme(string category)
    {
        return category switch
        {
            "Burgers & Snacks" => "burger",
            "Value Feast Combos" => "burger",
            "Mojito Drinks" => "mojito",
            "Coffee Drinks" => "coffee",
            "Silog & Rice Meals" => "silog",
            "Juice & Shakes" => "shake",
            "Beer & Beverages (18+)" => "beer",
            _ => "default"
        };
    }

    public static string GetCategoryEmoji(string category)
    {
        return category switch
        {
            "Burgers & Snacks" => "🍔",
            "Value Feast Combos" => "🎁",
            "Mojito Drinks" => "🍹",
            "Coffee Drinks" => "☕",
            "Silog & Rice Meals" => "🍗",
            "Juice & Shakes" => "🥤",
            "Beer & Beverages (18+)" => "🍺",
            _ => "✨"
        };
    }

    public static string GetCategoryWatermarkIcon(string category)
    {
        return category switch
        {
            "Burgers & Snacks" => "bi bi-fire",
            "Value Feast Combos" => "bi bi-gift-fill",
            "Mojito Drinks" => "bi bi-droplet-half",
            "Coffee Drinks" => "bi bi-cup-hot",
            "Silog & Rice Meals" => "bi bi-egg-fried",
            "Juice & Shakes" => "bi bi-cup-straw",
            "Beer & Beverages (18+)" => "bi bi-cup",
            _ => "bi bi-stars"
        };
    }
}

<div class="container py-4" id="menuTop">
    <!-- Top Live Status & Weather Beacon -->
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-3">
        <span class="live-status-pill shadow-xs">
            <span class="live-pulse-dot"></span>
            <span id="liveOpenStatusText">OPEN NOW &bull; Dine-in, Takeout &amp; Delivery active until 10:00 PM</span>
        </span>
        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small shadow-xs">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i>Purok 5 Tabon, Dalaguete &bull; <i class="bi bi-wind text-info me-1"></i>Breezy Rooftop Deck
        </span>
        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small shadow-xs">
            <i class="bi bi-wifi text-success me-1"></i>Free High-Speed Wi-Fi
        </span>
    </div>

    <!-- Menu Header -->
    <div class="text-center mb-4 py-2">
        <span class="badge bg-warning text-dark px-3 py-1 text-uppercase fw-bold mb-2 rounded-pill small">
            <i class="bi bi-cup-hot-fill me-1"></i> Fresh Dine-In &amp; Takeout Offerings
        </span>
        <h1 class="brand-font display-5 fw-bold mb-2">JMT CAFE Complete Menu</h1>
        <p class="text-muted max-w-600 mx-auto" style="max-width: 680px; line-height: 1.7;">
            Explore our crispy chicken meals with signature drinks, flame-grilled burger combos, golden French fries, Oreo and fruit shakes, handcrafted barista espresso, and sparkling fruit refreshers. Dine on our breezy open-air rooftop deck with free Wi-Fi!
        </p>

        <!-- Dual Container Quick-Jump Switcher Bar -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
            <a href="#facebookCompiledFeedContainer" class="btn btn-primary rounded-pill px-3 py-2 fw-bold shadow-xs small d-inline-flex align-items-center gap-2" style="background: #1877F2; border-color: #1877F2;">
                <i class="bi bi-facebook fs-6"></i>
                <span>Facebook Compiled Photos (@fbPhotoProducts.Count Photos)</span>
            </a>
            <a href="#foodCategorizationContainer" class="btn btn-warning rounded-pill px-3 py-2 fw-bold text-dark shadow-xs small d-inline-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap-fill text-dark fs-6"></i>
                <span>Food Categorization Hub (@allProductsList.Count Items)</span>
            </a>
            <a href="#deliveryEstimatorSection" class="btn btn-outline-dark rounded-pill px-3 py-2 fw-semibold shadow-xs small d-inline-flex align-items-center gap-2">
                <i class="bi bi-bicycle text-success fs-6"></i>
                <span>Delivery Estimator</span>
            </a>
            <a href="#wallPostersSection" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold shadow-xs small d-inline-flex align-items-center gap-2">
                <i class="bi bi-images text-warning fs-6"></i>
                <span>Wall Posters (21)</span>
            </a>
        </div>
    </div>

    <!-- Official Digital Viewing Showcase Notice Banner -->
    <div class="card border-0 rounded-4 p-3 p-md-4 mb-4 shadow-sm" 
         style="background: linear-gradient(135deg, #180E07 0%, #2A170C 100%); border: 1.5px solid #D4A373 !important;">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-warning flex-shrink-0" 
                         style="background: rgba(212, 163, 115, 0.2); border: 1.5px solid #D4A373; width: 48px; height: 48px;">
                        <i class="bi bi-eye-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h5 class="brand-font fw-bold text-white mb-0">Official Digital Viewing Menu</h5>
                            <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-0" style="font-size: 0.7rem;">View-Only Showcase</span>
                        </div>
                        <p class="small text-white-50 mb-0" style="line-height: 1.6;">
                            Our website showcases genuine menu items, real photos, and accurate prices. <strong>We do not process payments or orders through this website.</strong> All orders, advance food prep, and deliveries are coordinated directly via our official Facebook page or phone!
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end d-flex flex-wrap justify-content-lg-end gap-2">
                <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" 
                   class="btn btn-primary rounded-pill fw-bold px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2" 
                   style="background: #1877F2; border-color: #1877F2;">
                    <i class="bi bi-facebook fs-6"></i>
                    <span>Message on FB</span>
                </a>
                <a href="@JmtCafeConfig.PhoneTelLink" 
                   class="btn btn-outline-warning rounded-pill fw-semibold px-3 py-2 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-telephone-fill text-warning"></i>
                    <span>@JmtCafeConfig.PhoneDisplay</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ==================================================================== -->
    <!-- INTERACTIVE FEATURE 1: WHAT ARE YOU CRAVING? MOOD & MEAL FINDER     -->
    <!-- ==================================================================== -->
    <div class="craving-finder-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-stars text-warning fs-5"></i>
                <h6 class="brand-font fw-bold text-dark mb-0">What are you craving today?</h6>
                <span class="text-muted small d-none d-md-inline">&bull; Tap a craving to filter instantly</span>
            </div>
            <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0" onclick="clearCravingFilter()">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All
            </button>
        </div>
        <div class="craving-pills-wrap">
            <button type="button" class="craving-pill-btn active" onclick="filterByCraving('all', this)">
                <i class="bi bi-grid-fill text-warning"></i>
                <span>All Offerings (@allProductsList.Count)</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('heavy', this)">
                <span>🔥 10" Giant &amp; Big Feasts</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('snack', this)">
                <span>⚡ Under ₱50 Merienda Snacks</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('chicken', this)">
                <span>🍗 Crispy Chicken &amp; Silogs</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('coffee', this)">
                <span>☕ Handcrafted Coffee &amp; Latte Art</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('shakes', this)">
                <span>🥤 16oz Shakes &amp; Frappes</span>
            </button>
            <button type="button" class="craving-pill-btn" onclick="filterByCraving('mojito', this)">
                <span>🍹 Sparkling Fruit Mojitos</span>
            </button>
            <button type="button" class="craving-pill-btn text-danger" onclick="filterByCraving('favorites', this)">
                <i class="bi bi-heart-fill"></i>
                <span>My Saved Favorites (<span id="favCountPill">0</span>)</span>
            </button>
        </div>
    </div>

    <!-- Search & Filter Controls Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="category" value="@selectedCategory" />

            <div class="col-md-6 col-lg-7">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="liveMenuSearch" name="search" value="@searchQuery" class="form-control bg-light border-start-0 rounded-end-pill" 
                           placeholder="Search meals, burgers, shakes, frappes (e.g. Chicken, Burger, Oreo, Latte)..." 
                           oninput="runLiveMenuSearch()" autocomplete="off" />
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="input-group">
                    <label class="input-group-text bg-light small fw-semibold rounded-start-pill">Sort By</label>
                    <select name="sortBy" class="form-select bg-light small rounded-end-pill" onchange="this.form.submit()">
                        <option value="recommended" selected="@(sortBy == "recommended")">Recommended</option>
                        <option value="price-asc" selected="@(sortBy == "price-asc")">Price: Low to High</option>
                        <option value="price-desc" selected="@(sortBy == "price-desc")">Price: High to Low</option>
                        <option value="rating" selected="@(sortBy == "rating")">Highest Rated</option>
                    </select>
                </div>
            </div>

            <div class="col-md-2 col-lg-2">
                <button type="submit" class="btn btn-warning w-100 fw-bold rounded-pill text-dark shadow-sm">
                    <i class="bi bi-funnel-fill"></i> Filter
                </button>
            </div>

            <!-- Dynamic Quick Price Filter Chips -->
            <div class="col-12 pt-2 border-top mt-2 d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted fw-bold me-1"><i class="bi bi-funnel-fill text-warning me-1"></i>Quick Price:</span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 price-filter-chip active btn-warning text-dark" onclick="filterByPrice('all', this)">All Offerings</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 price-filter-chip" onclick="filterByPrice('under50', this)">Under ₱50</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 price-filter-chip" onclick="filterByPrice('50to150', this)">₱50 – ₱150</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 price-filter-chip" onclick="filterByPrice('over150', this)">₱150 &amp; Up</button>
                <div class="ms-auto small text-muted d-none d-md-block">
                    <i class="bi bi-check2-circle text-success me-1"></i>Showing <strong id="liveMatchCount" class="text-dark">@totalCount</strong> items
                </div>
            </div>
        </form>
    </div>

    <!-- Live Filter Empty State Message Container -->
    <div id="liveEmptyMessage" class="text-center py-5 my-4 bg-white rounded-4 shadow-sm border" style="display: none;">
        <i class="bi bi-search display-5 text-warning mb-2 d-block"></i>
        <h5 class="fw-bold brand-font">No matching menu items found</h5>
        <p class="text-muted small mb-3">Try clearing your filters or searching for "Burger", "Chicken", "Mojito", or "Coffee".</p>
        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-4" onclick="clearLiveFilter()">Reset Search</button>
    </div>

    <!-- ==================================================================== -->
    <!-- CONTAINER 1: FACEBOOK COMPILED PRODUCT PHOTOS FEED                   -->
    <!-- Compiles all products featured on Facebook that loads all product photos -->
    <!-- ==================================================================== -->
    <div id="facebookCompiledFeedContainer" class="fb-compiled-feed-container mb-5">
        <!-- Facebook Header Banner -->
        <div class="fb-feed-header-banner">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white p-2 rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
                        <i class="bi bi-facebook fs-2" style="color: #1877F2;"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h2 class="brand-font fw-bold fs-4 text-white mb-0">Official JMT Facebook Feed &amp; Photo Catalog</h2>
                            <span class="badge bg-white text-primary fw-bold rounded-pill px-2 py-1 small">
                                <i class="bi bi-patch-check-fill me-1"></i>Verified Storefront
                            </span>
                            <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 small">
                                @fbPhotoProducts.Count Authentic Photos Loaded
                            </span>
                        </div>
                        <p class="text-white-50 small mb-0" style="max-width: 740px; line-height: 1.5;">
                            All product photos below are compiled directly from our official Facebook posts (<strong>&#64;jmtcafe</strong>) and captured in our cafe in Purok 5 Tabon, Dalaguete, Cebu. 100% authentic in-cafe food &amp; drinks &bull; strictly zero AI-generated images.
                        </p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" 
                       class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm small d-inline-flex align-items-center gap-1">
                        <i class="bi bi-facebook"></i>
                        <span>Visit &#64;jmtcafe on Facebook</span>
                        <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Facebook Feed Filter Chips Bar -->
        <div class="fb-feed-filter-bar">
            <button type="button" class="fb-filter-pill active" onclick="filterFbFeed('all', this)">
                <i class="bi bi-collection-fill text-warning"></i>
                <span>All Facebook Photos (@fbPhotoProducts.Count)</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Burgers & Snacks', this)">
                <span>🍔 Burgers &amp; Snacks (@fbPhotoProducts.Count(p => p.Category == "Burgers & Snacks"))</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Value Feast Combos', this)">
                <span>🎁 Value Combos (@fbPhotoProducts.Count(p => p.Category == "Value Feast Combos"))</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Silog & Rice Meals', this)">
                <span>🍗 Silog Meals (@fbPhotoProducts.Count(p => p.Category == "Silog & Rice Meals"))</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Coffee Drinks', this)">
                <span>☕ Barista Coffee (@fbPhotoProducts.Count(p => p.Category == "Coffee Drinks"))</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Juice & Shakes', this)">
                <span>🥤 Shakes &amp; Frappes (@fbPhotoProducts.Count(p => p.Category == "Juice & Shakes"))</span>
            </button>
            <button type="button" class="fb-filter-pill" onclick="filterFbFeed('Mojito Drinks', this)">
                <span>🍹 Fruit Mojitos (@fbPhotoProducts.Count(p => p.Category == "Mojito Drinks"))</span>
            </button>
        </div>

        <!-- Facebook Photos Grid Container (Uniform Aspect Ratio & Height) -->
        <div class="p-3 p-md-4">
            <div class="row g-3 g-md-4" id="fbPhotosGrid">
                @foreach (var p in fbPhotoProducts)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3 fb-feed-col" data-id="@p.Id" data-category="@p.Category" data-name="@p.Name.ToLower()" data-price="@p.Price" data-desc="@p.Description.ToLower()">
                        <div class="fb-post-item-card h-100">
                            <!-- Facebook Post Card Header -->
                            <div class="fb-card-top-header">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="/images/jmt/jmt_logo.png" alt="JMT Logo" class="fb-card-avatar" />
                                    <div>
                                        <div class="fb-card-author-name">
                                            JMT CAFE <i class="bi bi-patch-check-fill text-primary" style="font-size: 0.75rem;"></i>
                                        </div>
                                        <div class="fb-card-post-meta">
                                            Tabon, Dalaguete &bull; <i class="bi bi-globe-americas"></i> Official Post
                                        </div>
                                    </div>
                                </div>
                                <span class="badge bg-light text-dark border rounded-pill small" style="font-size: 0.65rem;">
                                    @GetCategoryEmoji(p.Category) @p.Category
                                </span>
                            </div>

                            <!-- Photo Media Box with Uniform 4:3 Ratio -->
                            <div class="fb-card-media-box" 
                                 onclick="openPosterModal('@p.ImageUrl', '@p.Name - ₱@p.Price.ToString("N0") (Official JMT Facebook Post)')"
                                 title="Click to enlarge photo">
                                <img src="@p.ImageUrl" alt="@p.Name" class="fb-card-media-img" loading="lazy" />
                                
                                <span class="fb-media-tag">
                                    <i class="bi bi-camera-fill text-warning me-1"></i>Real Dish Photo
                                </span>
                                
                                <!-- Interactive Favorite Button -->
                                <button type="button" class="card-fav-btn" onclick="toggleFavorite(event, @p.Id, '@p.Name.Replace("\"", "\\\"")')" title="Save to Favorites" id="fav-fb-@p.Id">
                                    <i class="bi bi-heart"></i>
                                </button>
                                
                                <span class="fb-price-badge-overlay">
                                    ₱@p.Price.ToString("N0")
                                </span>
                            </div>

                            <!-- Post Caption Box with Uniform Height Alignment -->
                            <div class="fb-post-caption-box">
                                <h4 class="fb-card-title" title="@p.Name">@p.Name</h4>
                                <p class="fb-post-desc">@p.Description</p>
                                
                                @if (p.TastingNotes != null && p.TastingNotes.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mt-auto pb-1">
                                        @foreach (var note in p.TastingNotes.Take(2))
                                        {
                                            <span class="jmt-tasting-chip" style="font-size: 0.68rem;">@note</span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Facebook Action / Reaction Row + Quick Inquire on FB -->
                            <div class="fb-action-row">
                                <button type="button" class="fb-interaction-btn" onclick="toggleFbPostLike(this)" title="Like this dish post">
                                    <i class="bi bi-hand-thumbs-up"></i>
                                    <span class="like-label">Like</span>
                                    <span class="like-num">(@((p.Id * 7 % 37) + 18))</span>
                                </button>
                                <button type="button" class="fb-interaction-btn border-left text-primary" 
                                        onclick='openJmtInquiryModal({ id: @p.Id, name: "@p.Name.Replace("\"", "\\\"")", price: @p.Price, imageUrl: "@p.ImageUrl", category: "@p.Category", description: "@p.Description.Replace("\"", "\\\"")" })'
                                        title="View dish details and inquire on Facebook">
                                    <i class="bi bi-facebook text-primary"></i>
                                    <span>Inquire on FB</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ==================================================================== -->
    <!-- CONTAINER 2: FOOD CATEGORIZATION SYSTEM                              -->
    <!-- Categorization happened based on foods, drinks, and culinary types   -->
    <!-- ==================================================================== -->
    <div id="foodCategorizationContainer" class="food-categorization-container mb-5">
        <!-- Categorization Header Strip -->
        <div class="food-cat-header-strip d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="badge bg-dark text-warning rounded-pill px-3 py-1 fw-bold small text-uppercase">
                        <i class="bi bi-diagram-3-fill me-1"></i> Food Categorization System
                    </span>
                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 fw-bold small">
                        7 Culinary Categories
                    </span>
                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                        @allProductsList.Count Accurate Menu Items
                    </span>
                </div>
                <h2 class="brand-font fw-bold fs-3 text-dark mb-1">
                    Accurate Food &amp; Drinks Categorization
                </h2>
                <p class="text-muted small mb-0" style="max-width: 760px; line-height: 1.6;">
                    Categorized strictly by food &amp; drink types according to official JMT laminated wall flyers and Facebook post postings. Every menu item and price is verified directly from in-cafe postings in Purok 5 Tabon, Dalaguete. Strictly zero AI-generated products.
                </p>
            </div>
            <div>
                <a href="@JmtCafeConfig.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-3">
                    <i class="bi bi-facebook me-1"></i> Compare on Official FB Page
                </a>
            </div>
        </div>

        <!-- Food Category Navigation Hub Cards -->
        <div class="food-cat-pills-row">
            @foreach (var catDef in categoryDefs)
            {
                var count = categoryCounts.ContainsKey(catDef.Key) ? categoryCounts[catDef.Key] : allProductsList.Count(p => p.Category == catDef.Key);
                <a href="#@catDef.AnchorId" class="food-cat-nav-card" onclick="scrollToCategory('@catDef.AnchorId'); return false;" id="navCard-@catDef.AnchorId">
                    <div class="food-cat-nav-icon">
                        @catDef.Emoji
                    </div>
                    <div class="food-cat-nav-info">
                        <span class="food-cat-nav-title">@catDef.ShortName</span>
                        <span class="food-cat-nav-count">@count items &bull; @catDef.PriceRange</span>
                    </div>
                </a>
            }
        </div>

        <!-- Categorized Sections for Each Food Type -->
        @if (isCategorizedView)
        {
            @foreach (var catDef in categoryDefs)
            {
                var catItems = allProductsList.Where(p => p.Category.Equals(catDef.Key, StringComparison.OrdinalIgnoreCase)).ToList();
                if (!catItems.Any()) continue;

