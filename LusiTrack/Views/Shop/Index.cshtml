@model IEnumerable<CoffeeProduct>
@{
    ViewData["Title"] = "Reserve Coffee & Roastery Menu";
    var categories = ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>();
    var selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var productList = Model.ToList();

    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? productList.Count;
    var pageSize = ViewBag.PageSize as int? ?? 6;
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<string, int> ?? new Dictionary<string, int>();

    var startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<!-- Menu Hero Section -->
<div class="py-5 text-white" style="background: radial-gradient(circle at 50% 30%, #3a2215 0%, #170d08 100%); border-bottom: 1px solid rgba(219, 162, 100, 0.2);">
    <div class="container text-center py-2">
        <span class="hero-badge mb-3">
            <i class="bi bi-cup-hot-fill text-warning"></i> Sourced Directly from Origin
        </span>
        <h1 class="display-4 brand-font fw-bold mb-3 text-white">Our Handcrafted Menu</h1>
        <p class="lead text-white-50 max-w-700 mx-auto" style="font-size: 1.1rem; line-height: 1.6;">
            Explore rare single-origin roasts, signature espresso drinks, velvet cold brews, and fresh morning pastries baked daily in our roastery.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Artisanal Coffee & Menu Search Bar -->
    <div class="shop-search-card">
        <form asp-action="Index" method="get" id="coffeeSearchForm">
            <input type="hidden" name="category" value="@selectedCategory" />
            <div class="shop-search-wrapper">
                <i class="bi bi-search shop-search-icon"></i>
                <input type="text" 
                       id="coffeeSearchInput"
                       name="search" 
                       class="form-control shop-search-input" 
                       placeholder="Search coffees by name, origin (Ethiopia, Colombia...), notes (caramel, jasmine...), or pastries..." 
                       value="@searchQuery" 
                       autocomplete="off" />
                <div class="shop-search-btn-wrap">
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <a asp-action="Index" asp-route-category="@selectedCategory" class="shop-search-clear-btn" title="Clear search">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                    <button type="submit" class="shop-search-submit-btn">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>
            </div>
        </form>

        <!-- Quick Pick Tags / Curated Coffee Suggestions -->
        <div class="shop-search-tags">
            <span class="shop-search-tag-label">
                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Trending:
            </span>
            <a asp-action="Index" asp-route-search="Ethiopian" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Ethiopian", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-geo-alt"></i> Ethiopian Yirgacheffe
            </a>
            <a asp-action="Index" asp-route-search="Geisha" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Geisha", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-stars"></i> Colombia Geisha
            </a>
            <a asp-action="Index" asp-route-search="Nitro" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Nitro", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-snow2"></i> Nitro Cold Brew
            </a>
            <a asp-action="Index" asp-route-search="Macchiato" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Macchiato", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-cup-hot"></i> Caramel Macchiato
            </a>
            <a asp-action="Index" asp-route-search="Croissant" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Croissant", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-cake2"></i> Almond Croissant
            </a>
            <a asp-action="Index" asp-route-search="Dark" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Dark", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-fire"></i> Dark Roast
            </a>
            <a asp-action="Index" asp-route-search="Matcha" asp-route-category="All" 
               class="shop-search-chip @(searchQuery.Equals("Matcha", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="bi bi-flower1"></i> Uji Matcha
            </a>
        </div>
    </div>

    <!-- Active Search Result Banner -->
    @if (!string.IsNullOrWhiteSpace(searchQuery))
    {
        <div class="search-active-banner">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill">
                    <i class="bi bi-funnel-fill me-1"></i> Filtered
                </span>
                <span class="text-dark">
                    Found <strong>@totalItems</strong> item@(totalItems == 1 ? "" : "s") matching 
                    "<span class="fw-bold text-dark">@searchQuery</span>"
                    @if (selectedCategory != "All")
                    {
                        <span> in <em>@selectedCategory</em></span>
                    }
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" asp-route-category="@selectedCategory" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                    <i class="bi bi-x-lg me-1"></i> Clear Search
                </a>
                @if (selectedCategory != "All")
                {
                    <a asp-action="Index" asp-route-search="@searchQuery" asp-route-category="All" class="btn btn-sm btn-coffee-outline rounded-pill px-3">
                        Search in All Categories
                    </a>
                }
            </div>
        </div>
    }

    <!-- Category Filter Pills -->
    <div class="filter-pill-container">
        <a asp-action="Index" asp-route-category="All" asp-route-search="@searchQuery" asp-route-page="1" 
           class="filter-pill @(selectedCategory == "All" ? "active" : "")">
            <i class="bi bi-grid-fill me-1"></i> All Items (@(categoryCounts.TryGetValue("All", out var allCount) ? allCount : totalItems))
        </a>
        @foreach (var cat in categories)
        {
            var catCount = categoryCounts.TryGetValue(cat, out var cnt) ? cnt : 0;
            <a asp-action="Index" asp-route-category="@cat" asp-route-search="@searchQuery" asp-route-page="1" 
               class="filter-pill @(selectedCategory == cat ? "active" : "")">
                @if (cat.Contains("Whole Bean"))
                {
                    <i class="bi bi-bag-check-fill text-warning me-1"></i>
                }
                else if (cat.Contains("Cold"))
                {
                    <i class="bi bi-snow2 text-info me-1"></i>
                }
                else if (cat.Contains("Bakery"))
                {
                    <i class="bi bi-cake2-fill text-warning me-1"></i>
                }
                else
                {
                    <i class="bi bi-cup-hot-fill text-warning me-1"></i>
                }
                @cat (@catCount)
            </a>
        }
    </div>

    <!-- Product Grid & Pagination Info -->
    @if (!productList.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mb-3">
                <div class="brand-icon-wrap mx-auto" style="width: 72px; height: 72px; font-size: 2rem;">
                    <i class="bi bi-search text-warning"></i>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <h3 class="brand-font fw-bold">No Matches Found</h3>
                <p class="text-muted max-w-500 mx-auto">
                    We couldn't find any coffees or menu items matching "<strong>@searchQuery</strong>" 
                    @(selectedCategory != "All" ? $"within the {selectedCategory} category" : "").
                </p>
                <div class="d-flex justify-content-center gap-3 mt-3">
                    @if (selectedCategory != "All")
                    {
                        <a asp-action="Index" asp-route-search="@searchQuery" asp-route-category="All" class="btn btn-coffee-outline">
                            Search All Categories
                        </a>
                    }
                    <a asp-action="Index" asp-route-category="All" class="btn btn-coffee-primary">
                        View Complete Menu
                    </a>
                </div>
            }
            else
            {
                <h3 class="brand-font fw-bold">No Coffees Found</h3>
                <p class="text-muted">There are currently no items matching the selected category.</p>
                <div class="mt-3">
                    <a asp-action="Index" asp-route-category="All" asp-route-page="1" class="btn btn-coffee-primary text-decoration-none">
                        View Complete Menu
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Pagination Count Bar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <span class="text-muted small">
                Showing <strong>@startItem – @endItem</strong> of <strong>@totalItems</strong> specialty coffees
            </span>
            <span class="badge bg-white border text-dark px-3 py-2 rounded-pill small">
                Page @currentPage of @totalPages
            </span>
        </div>

        <!-- Product Cards Grid -->
        <div class="row g-4" id="coffeeCatalogGrid">
            @foreach (var item in productList)
            {
                <div class="col-md-6 col-lg-4 coffee-card-item" 
                     data-name="@item.Name.ToLowerInvariant()" 
                     data-origin="@(item.Origin?.ToLowerInvariant() ?? "")" 
                     data-flavor="@(item.FlavorNotes?.ToLowerInvariant() ?? "")" 
                     data-category="@item.Category.ToLowerInvariant()">
                    <div class="card card-coffee h-100 d-flex flex-column">
                        <!-- Product Image Wrap -->
                        <div class="card-coffee-img-wrap">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" class="card-coffee-img" alt="@item.Name" loading="lazy" />
                            </a>
                            <span class="badge-overlay-category">@item.Category</span>
                            @if (!string.IsNullOrEmpty(item.Origin))
                            {
                                <span class="badge-overlay-origin">
                                    <i class="bi bi-geo-alt-fill text-warning"></i> @item.Origin
                                </span>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Roast Meter & Tag -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-secondary">
                                    @(item.RoastLevel != "N/A" ? $"{item.RoastLevel} Roast" : "Artisanal Specialty")
                                </span>
                                @if (item.RoastIntensity > 0)
                                {
                                    <div class="roast-meter" title="Roast Intensity: @item.RoastIntensity / 5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="roast-dot @(i <= item.RoastIntensity ? "filled" : "")"></span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Product Name -->
                            <h5 class="brand-font fs-6 fw-bold mb-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                    @item.Name
                                </a>
                            </h5>

                            <!-- Flavor Notes Pill -->
                            @if (!string.IsNullOrEmpty(item.FlavorNotes))
                            {
                                <div class="mb-2">
                                    <span class="flavor-pill">
                                        <i class="bi bi-flower1 text-warning me-1"></i> @item.FlavorNotes
                                    </span>
                                </div>
                            }

                            <!-- Description -->
                            <p class="text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @item.Description
                            </p>

                            <!-- Price & Bottom Controls -->
                            <div class="pt-3 border-top d-flex align-items-center justify-content-between gap-2">
                                <div>
                                    <span class="fs-5 fw-bold text-dark">@item.Price.ToString("C")</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-coffee-outline px-3">
                                        Details
                                    </a>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-coffee-primary px-3">
                                            <i class="bi bi-plus-lg"></i> Add
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (totalPages > 1)
        {
            <nav aria-label="Coffee Catalog Pagination" class="mt-4">
                <ul class="pagination-coffee">
                    <!-- Previous Button -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-category="@selectedCategory" asp-route-search="@searchQuery" asp-route-page="@(currentPage - 1)" aria-label="Previous Page">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    <!-- Numbered Pages -->
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-category="@selectedCategory" asp-route-search="@searchQuery" asp-route-page="@p">
                                @p
                            </a>
                        </li>
                    }

                    <!-- Next Button -->
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-category="@selectedCategory" asp-route-search="@searchQuery" asp-route-page="@(currentPage + 1)" aria-label="Next Page">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('coffeeSearchInput');
        const clearBtn = document.querySelector('.shop-search-clear-btn');
        const cardItems = document.querySelectorAll('.coffee-card-item');

        if (!searchInput) return;

        // Debounced live filter on current page items while typing
        let liveFilterTimeout = null;
        searchInput.addEventListener('input', function () {
            clearTimeout(liveFilterTimeout);
            const query = this.value.trim().toLowerCase();

            liveFilterTimeout = setTimeout(() => {
                if (!cardItems.length) return;
                
                if (query === '') {
                    cardItems.forEach(card => card.style.display = '');
                    return;
                }

                cardItems.forEach(card => {
                    const name = card.dataset.name || '';
                    const origin = card.dataset.origin || '';
                    const flavor = card.dataset.flavor || '';
                    const category = card.dataset.category || '';

                    const matches = name.includes(query) || 
                                    origin.includes(query) || 
                                    flavor.includes(query) || 
                                    category.includes(query);

                    card.style.display = matches ? '' : 'none';
                });
            }, 150);
        });
    });
</script>
}
