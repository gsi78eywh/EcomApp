<!-- INTERACTIVE FEATURE 6: TOAST NOTIFICATION CONTAINER                     -->
<!-- ======================================================================== -->
<div class="jmt-toast-container" id="jmtToastContainer"></div>

@section Scripts {
    <script>
        // ====================================================================
        // Core Lightbox & Anchor Scrolling
        // ====================================================================
        function openPosterModal(imgSrc, title) {
            document.getElementById('posterLightboxImg').src = imgSrc;
            document.getElementById('posterLightboxTitle').innerText = title;
            const modal = new bootstrap.Modal(document.getElementById('posterLightboxModal'));
            modal.show();
        }

        function scrollToCategory(anchorId) {
            const el = document.getElementById(anchorId);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                document.querySelectorAll('.food-cat-nav-card').forEach(p => p.classList.remove('active'));
                const navCard = document.getElementById('navCard-' + anchorId);
                if (navCard) {
                    navCard.classList.add('active');
                }
            }
        }

        // Active Category Section Tracker on Scroll
        document.addEventListener('DOMContentLoaded', () => {
            initLiveStatus();
            initFavorites();

            const sections = document.querySelectorAll('.menu-category-section');
            if (!sections.length) return;

            const observerOptions = {
                root: null,
                rootMargin: '-100px 0px -60% 0px',
                threshold: 0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        document.querySelectorAll('.food-cat-nav-card').forEach(p => p.classList.remove('active'));
                        const currentCard = document.getElementById('navCard-' + id);
                        if (currentCard) {
                            currentCard.classList.add('active');
                        }
                    }
                });
            }, observerOptions);

            sections.forEach(s => observer.observe(s));
        });

        // ====================================================================
        // Interactive Feature 1: Craving & Mood Finder
        // ====================================================================
        function filterByCraving(craving, btn) {
            document.querySelectorAll('.craving-pill-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const catCards = document.querySelectorAll('.menu-filter-card');
            const fbCards = document.querySelectorAll('.fb-feed-col');
            let matched = 0;

            const filterCard = (card) => {
                const name = card.getAttribute('data-name') || '';
                const cat = (card.getAttribute('data-cat') || card.getAttribute('data-category') || '').toLowerCase();
                const price = parseFloat(card.getAttribute('data-price') || '0');
                const id = parseInt(card.getAttribute('data-id') || '0');

                let isMatch = true;

                if (craving === 'heavy') {
                    isMatch = name.includes('giant') || name.includes('10-inch') || name.includes('combo') || name.includes('chicken meal');
                } else if (craving === 'snack') {
                    isMatch = price <= 50;
                } else if (craving === 'chicken') {
                    isMatch = cat.includes('silog') || name.includes('chicken');
                } else if (craving === 'coffee') {
                    isMatch = cat.includes('coffee');
                } else if (craving === 'shakes') {
                    isMatch = cat.includes('juice') || cat.includes('shake') || name.includes('frappe');
                } else if (craving === 'mojito') {
                    isMatch = cat.includes('mojito');
                } else if (craving === 'favorites') {
                    const favs = getFavoritesList();
                    isMatch = favs.includes(id);
                }

                if (isMatch) {
                    card.classList.remove('is-hidden');
                    card.style.display = 'block';
                    matched++;
                } else {
                    card.classList.add('is-hidden');
                    card.style.display = 'none';
                }
            };

            catCards.forEach(filterCard);
            fbCards.forEach(filterCard);

            // Update live counter
            const countEl = document.getElementById('liveMatchCount');
            if (countEl) countEl.innerText = matched;

            // Empty state check
            const emptyEl = document.getElementById('liveEmptyMessage');
            if (emptyEl) {
                emptyEl.style.display = (matched === 0) ? 'block' : 'none';
            }

            // Hide empty category sections
            document.querySelectorAll('.menu-category-section').forEach(sec => {
                const visibleInSec = sec.querySelectorAll('.menu-filter-card:not(.is-hidden)').length;
                sec.style.display = (visibleInSec === 0 && matched > 0) ? 'none' : 'block';
            });

            if (craving !== 'all') {
                showToast(`Filtered by ${btn.innerText.trim()} (${matched} items found)`, 'bi-funnel-fill');
            }
        }

        function clearCravingFilter() {
            filterByCraving('all', document.querySelector('.craving-pill-btn'));
            clearLiveFilter();
        }

        // ====================================================================
        // Interactive Feature 2: Real-time Operating Status Beacon
        // ====================================================================
        function initLiveStatus() {
            const now = new Date();
            // Local Philippines Time is UTC+8
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const phTime = new Date(utc + (3600000 * 8));
            const hours = phTime.getHours();

            const statusEl = document.getElementById('liveOpenStatusText');
            if (!statusEl) return;

            if (hours >= 9 && hours < 22) {
                statusEl.innerHTML = `<strong>OPEN NOW</strong> &bull; Dine-in, Takeout &amp; Delivery active until 10:00 PM`;
            } else {
                statusEl.innerHTML = `<strong>OPENS AT 9:00 AM</strong> &bull; Advance Orders &amp; Inquiries Welcome for Tomorrow!`;
            }
        }

        // ====================================================================
        // Interactive Feature 3: Dish Favorites / Heart Wishlist
        // ====================================================================
        function getFavoritesList() {
            try {
                return JSON.parse(localStorage.getItem('jmt_favorites') || '[]');
            } catch (e) {
                return [];
            }
        }

        function saveFavoritesList(favs) {
            try {
                localStorage.setItem('jmt_favorites', JSON.stringify(favs));
            } catch (e) {}
        }

        function initFavorites() {
            const favs = getFavoritesList();
            updateFavPillCount(favs.length);

            favs.forEach(id => {
                document.querySelectorAll(`[id^="fav-"][id$="-${id}"]`).forEach(btn => {
                    btn.classList.add('favorited');
                    btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
                });
            });
        }

        function updateFavPillCount(count) {
            const pill = document.getElementById('favCountPill');
            if (pill) pill.innerText = count;
        }

        function toggleFavorite(event, id, name) {
            event.stopPropagation();
            event.preventDefault();

            let favs = getFavoritesList();
            const index = favs.indexOf(id);
            let isFav = false;

            if (index === -1) {
                favs.push(id);
                isFav = true;
                showToast(`Saved "${name}" to Favorites!`, 'bi-heart-fill');
            } else {
                favs.splice(index, 1);
                isFav = false;
                showToast(`Removed "${name}" from Favorites`, 'bi-heart');
            }

            saveFavoritesList(favs);
            updateFavPillCount(favs.length);

            document.querySelectorAll(`[id^="fav-"][id$="-${id}"]`).forEach(btn => {
                if (isFav) {
                    btn.classList.add('favorited');
                    btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
                } else {
                    btn.classList.remove('favorited');
                    btn.innerHTML = '<i class="bi bi-heart"></i>';
                }
            });
        }

        // ====================================================================
        // Interactive Feature 4: Dalaguete Delivery Fee Estimator
        // ====================================================================
        let currentSelectedLocation = "Purok 5 Tabon Proper (Near Shop)";
        let currentDeliveryFee = 50;

        function calculateDeliveryFee() {
            const val = document.getElementById('deliveryLocationSelect').value;
            const parts = val.split('|');
            currentDeliveryFee = parseInt(parts[0]) || 50;
            const timeStr = parts[1] || '15–20 mins';
            currentSelectedLocation = parts[2] || 'Purok 5 Tabon';

            document.getElementById('estFeeDisplay').innerText = `₱${currentDeliveryFee}`;
            document.getElementById('estTimeDisplay').innerHTML = `<i class="bi bi-clock me-1 text-warning"></i>Estimated Travel: ${timeStr}`;
        }

        function orderWithDelivery() {
            calculateDeliveryFee();
            showToast(`Opening Facebook to inquire for delivery to ${currentSelectedLocation}...`, 'bi-bicycle');
            setTimeout(() => {
                window.open('https://www.facebook.com/profile.php?id=61566969959363', '_blank');
            }, 500);
        }

        // ====================================================================
        // Interactive Feature 6: Floating Toast System
        // ====================================================================
        function showToast(message, iconClass = 'bi-check-circle-fill') {
            const container = document.getElementById('jmtToastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'jmt-toast';
            toast.innerHTML = `<i class="bi ${iconClass}"></i> <span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(15px)';
                setTimeout(() => { toast.remove(); }, 300);
            }, 3200);
        }

        // ====================================================================
        // Facebook Feed Category Filter Engine
        // ====================================================================
        function filterFbFeed(cat, btn) {
            document.querySelectorAll('.fb-filter-pill').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const cols = document.querySelectorAll('.fb-feed-col');
            cols.forEach(col => {
                const itemCat = col.getAttribute('data-category') || '';
                if (cat === 'all' || itemCat.toLowerCase() === cat.toLowerCase()) {
                    col.style.display = 'block';
                } else {
                    col.style.display = 'none';
                }
            });
        }

        // Interactive Facebook Post Like Button
        function toggleFbPostLike(btn) {
            btn.classList.toggle('liked');
            const icon = btn.querySelector('i');
            const label = btn.querySelector('.like-label');
            const numEl = btn.querySelector('.like-num');
            let count = parseInt(numEl.innerText.replace(/\D/g, '')) || 0;

            if (btn.classList.contains('liked')) {
                icon.className = 'bi bi-hand-thumbs-up-fill text-primary';
                label.innerText = 'Liked';
                count++;
                showToast('Liked! Salamat sa suporta sa JMT CAFE!', 'bi-hand-thumbs-up-fill');
            } else {
                icon.className = 'bi bi-hand-thumbs-up';
                label.innerText = 'Like';
                count = Math.max(0, count - 1);
            }
            numEl.innerText = '(' + count + ')';
        }

        // Instant Dynamic Live Menu Search & Price Filter Engine
        let currentPriceFilter = 'all';

        function filterByPrice(filter, btn) {
            currentPriceFilter = filter;
            document.querySelectorAll('.price-filter-chip').forEach(b => {
                b.classList.remove('active', 'btn-warning', 'text-dark');
            });
            btn.classList.add('active', 'btn-warning', 'text-dark');
            runLiveMenuSearch();
        }

        function clearLiveFilter() {
            const input = document.getElementById('liveMenuSearch');
            if (input) input.value = '';
            currentPriceFilter = 'all';
            document.querySelectorAll('.price-filter-chip').forEach((b, idx) => {
                if (idx === 0) b.classList.add('active', 'btn-warning', 'text-dark');
                else b.classList.remove('active', 'btn-warning', 'text-dark');
            });
            runLiveMenuSearch();
        }

        function runLiveMenuSearch() {
            const query = (document.getElementById('liveMenuSearch')?.value || '').trim().toLowerCase();
            const cards = document.querySelectorAll('.menu-filter-card');
            const fbCols = document.querySelectorAll('.fb-feed-col');
            let matchCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const cat = card.getAttribute('data-cat') || '';
                const desc = card.getAttribute('data-desc') || '';
                const price = parseFloat(card.getAttribute('data-price') || '0');

                const matchesQuery = !query || name.includes(query) || cat.includes(query) || desc.includes(query);

                let matchesPrice = true;
                if (currentPriceFilter === 'under50') {
                    matchesPrice = price < 50;
                } else if (currentPriceFilter === '50to150') {
                    matchesPrice = price >= 50 && price <= 150;
                } else if (currentPriceFilter === 'over150') {
                    matchesPrice = price > 150;
                }

                if (matchesQuery && matchesPrice) {
                    card.classList.remove('is-hidden');
                    card.style.display = 'block';
                    matchCount++;
                } else {
                    card.classList.add('is-hidden');
                    card.style.display = 'none';
                }
            });

            fbCols.forEach(col => {
                const name = col.getAttribute('data-name') || '';
                const cat = (col.getAttribute('data-category') || '').toLowerCase();
                const desc = col.getAttribute('data-desc') || '';
                const price = parseFloat(col.getAttribute('data-price') || '0');

                const matchesQuery = !query || name.includes(query) || cat.includes(query) || desc.includes(query);

                let matchesPrice = true;
                if (currentPriceFilter === 'under50') {
                    matchesPrice = price < 50;
                } else if (currentPriceFilter === '50to150') {
                    matchesPrice = price >= 50 && price <= 150;
                } else if (currentPriceFilter === 'over150') {
                    matchesPrice = price > 150;
                }

                if (matchesQuery && matchesPrice) {
                    col.style.display = 'block';
                } else {
                    col.style.display = 'none';
                }
            });

            const countEl = document.getElementById('liveMatchCount');
            if (countEl) countEl.innerText = matchCount;

            const emptyEl = document.getElementById('liveEmptyMessage');
            if (emptyEl) {
                emptyEl.style.display = (matchCount === 0) ? 'block' : 'none';
            }

            document.querySelectorAll('.menu-category-section').forEach(sec => {
                const visibleInSec = sec.querySelectorAll('.menu-filter-card:not(.is-hidden)').length;
                sec.style.display = (visibleInSec === 0 && matchCount > 0) ? 'none' : 'block';
            });
        }
    </script>
}
