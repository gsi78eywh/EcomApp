@model CoffeeProduct
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.Related as IEnumerable<CoffeeProduct> ?? Enumerable.Empty<CoffeeProduct>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none">Menu</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>1


    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
        <div class="row g-0">
            <div class="col-lg-6">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="min-height: 380px; max-height: 480px; object-fit: cover;" />
            </div>
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark">@Model.Category</span>
                        @if (Model.RoastLevel != "N/A")
                        {
                            <span class="badge bg-dark">@Model.RoastLevel Roast</span>
                        }
                        <span class="badge bg-success bg-opacity-10 text-success">In Stock</span>
                    </div>

                    <h1 class="brand-font fw-bold display-6 mb-3">@Model.Name</h1>

                    <div class="mb-4">
                        <span class="fs-2 fw-bold text-success">@Model.Price.ToString("C")</span>
                        <span class="text-muted small ms-2">tax included at checkout</span>
                    </div>

                    <p class="text-muted lead fs-6 mb-4">
                        @Model.Description
                    </p>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <div class="row g-2 text-center small">
                            <div class="col-4 border-end">
                                <div class="text-muted">Aroma</div>
                                <div class="fw-bold">Intense & Fresh</div>
                            </div>
                            <div class="col-4 border-end">
                                <div class="text-muted">Origin</div>
                                <div class="fw-bold">Direct Harvest</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted">Roast Freshness</div>
                                <div class="fw-bold">&lt; 48 hrs</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add to Cart Form -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action(

"Index", "Cart")" />
                    <div class="row g-3 align-items-center">
                        <div class="col-sm-4">
                            <label class="form-label small fw-semibold">Quantity</label>
                            <div class="input-group">
                                <button type="button" class="btn btn-outline-secondary" onclick="let q=document.getElementById('qty');if(q.value>1)q.value--;">-</button>
                                <input type="number" id="qty" name="quantity" value="1" min="1" max="99" class="form-control text-center fw-bold" />
                                <button type="button" class="btn btn-outline-secondary" onclick="let q=document.getElementById('qty');q.value++;">+</button>
                            </div>
                        </div>
                        <div class="col-sm-8 pt-sm-4">
                            <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold text-dark rounded-pill shadow-sm">
                                <i class="bi bi-bag-plus-fill me-2"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <h3 class="brand-font fw-bold mb-4">You Might Also Enjoy</h3>
        <div class="row g-4">
            @foreach (var rel in related)
            {
                <div class="col-md-4">
                    <div class="card card-coffee h-100">
                        <img src="@rel.ImageUrl" class="card-img-top" alt="@rel.Name" style="height: 180px; object-fit: cover;" />
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-secondary bg-opacity-10 text-dark small">@rel.Category</span>
                                <span class="fw-bold text-success">@rel.Price.ToString("C")</span>
                            </div>
                            <h6 class="fw-bold brand-font mb-2">
                                <a asp-action="Details" asp-route-id="@rel.Id" class="text-dark text-decoration-none">
                                    @rel.Name
                                </a>
                            </h6>
                            <a asp-action="Details" asp-route-id="@rel.Id" class="btn btn-outline-dark btn-sm w-100 rounded-pill">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
