@model CoffeeProduct
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.Related as IEnumerable<CoffeeProduct> ?? Enumerable.Empty<CoffeeProduct>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">Menu</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Main Product Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
        <div class="row g-0">
            <!-- Left: Hero Imagery & Badges -->
            <div class="col-lg-6 position-relative bg-light">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" 
                     style="min-height: 480px; max-height: 600px; object-fit: cover;" />
                
                <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                    <span class="badge bg-dark bg-opacity-75 text-warning px-3 py-2 rounded-pill small">
                        <i class="bi bi-award-fill me-1"></i> Specialty Reserve
                    </span>
                    @if (!string.IsNullOrEmpty(Model.Origin))
                    {
                        <span class="badge bg-white text-dark shadow-sm px-3 py-2 rounded-pill small">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> @Model.Origin
                        </span>
                    }
                </div>
            </div>

            <!-- Right: Details & Purchase -->
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <!-- Top Category & Roast Meter -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <span class="badge bg-warning bg-opacity-20 text-dark px-3 py-1 rounded-pill small fw-bold">
                            @Model.Category
                        </span>

                        @if (Model.RoastIntensity > 0)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted fw-semibold">Roast: @Model.RoastLevel</span>
                                <div class="roast-meter" title="Roast Intensity: @Model.RoastIntensity / 5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="roast-dot @(i <= Model.RoastIntensity ? "filled" : "")"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Title -->
                    <h1 class="brand-font fw-bold display-6 mb-3">@Model.Name</h1>

                    <!-- Price & Stock -->
                    <div class="d-flex align-items-baseline gap-3 mb-4">
                        <span class="fs-2 fw-bold text-dark">@Model.Price.ToString("C")</span>
                        <span class="text-success small fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i> Fresh in Stock • Ready for Roasting
                        </span>
                    </div>

                    <!-- Flavor Notes Pill -->
                    @if (!string.IsNullOrEmpty(Model.FlavorNotes))
                    {
                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <span class="d-block text-uppercase text-muted small fw-bold mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">Cupping & Flavor Notes</span>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-flower1 text-warning me-1"></i> @Model.FlavorNotes
                            </span>
                        </div>
                    }

                    <!-- Description -->
                    <p class="text-secondary lead fs-6 mb-4" style="line-height: 1.7;">
                        @Model.Description
                    </p>

                    <!-- Coffee Specifications Grid -->
                    <div class="row g-2 mb-4 text-center small">
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-light h-100">
                                <span class="text-muted d-block" style="font-size: 0.72rem;">PROCESSING</span>
                                <strong class="text-dark">@Model.Process</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-light h-100">
                                <span class="text-muted d-block" style="font-size: 0.72rem;">ALTITUDE</span>
                                <strong class="text-dark">@Model.Altitude</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-3 bg-light h-100">
                                <span class="text-muted d-block" style="font-size: 0.72rem;">RECOMMENDED</span>
                                <strong class="text-dark">@Model.BrewGuide</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add to Cart Controls -->
                <div class="pt-4 border-top">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Cart")" />

                        <div class="row g-3 align-items-center">
                            <!-- Stepper -->
                            <div class="col-sm-4">
                                <label class="form-label small fw-semibold text-muted mb-1">Quantity</label>
                                <div class="qty-stepper w-100 justify-content-between p-1">
                                    <button type="button" class="btn-step" onclick="let q=document.getElementById('productQty');if(q.value>1)q.value--;">&minus;</button>
                                    <input type="number" id="productQty" name="quantity" value="1" min="1" max="99" />
                                    <button type="button" class="btn-step" onclick="let q=document.getElementById('productQty');q.value++;">&#43;</button>
                                </div>
                            </div>

                            <!-- CTA Button -->
                            <div class="col-sm-8 pt-sm-4">
                                <button type="submit" class="btn-coffee-primary w-100 py-3 shadow">
                                    <i class="bi bi-bag-plus-fill me-2 fs-5"></i> Add to Coffee Bag
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Assurance Footnote -->
                    <div class="d-flex align-items-center justify-content-between mt-3 text-muted small pt-2">
                        <span><i class="bi bi-truck text-warning me-1"></i> Free delivery over $35</span>
                        <span><i class="bi bi-shield-check text-success me-1"></i> 100% Freshness Guaranteed</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Roastery Information Accordion -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-5">
        <h4 class="brand-font fw-bold mb-3">Roaster's Tasting Notes & Brewing Guide</h4>
        <div class="accordion accordion-flush" id="coffeeAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="flush-headingOne">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne">
                        <i class="bi bi-gear-wide-connected text-warning me-2"></i> Recommended Brewing Recipe
                    </button>
                </h2>
                <div id="flush-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#coffeeAccordion">
                    <div class="accordion-body text-secondary small" style="line-height: 1.7;">
                        For pour-over methods, we suggest a <strong>1:16 brew ratio</strong> (18g coffee to 290g water) with water brought to 93°C (200°F). Bloom with 50g of water for 45 seconds to allow CO₂ degassing, then pour in steady concentric spirals for a total brew time of approximately 3:15.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="flush-headingTwo">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTwo">
                        <i class="bi bi-globe-americas text-warning me-2"></i> Direct Trade Farm Sourcing
                    </button>
                </h2>
                <div id="flush-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#coffeeAccordion">
                    <div class="accordion-body text-secondary small" style="line-height: 1.7;">
                        Harvested by independent multi-generational family growers who selectively hand-pick only deep crimson ripe cherries. This coffee is processed with eco-pulpers and washed in cold mountain spring water to preserve organic purity.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="flush-headingThree">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseThree">
                        <i class="bi bi-box2-heart text-warning me-2"></i> Packaging & Degassing Valve
                    </button>
                </h2>
                <div id="flush-collapseThree" class="accordion-collapse collapse" data-bs-parent="#coffeeAccordion">
                    <div class="accordion-body text-secondary small" style="line-height: 1.7;">
                        Sealed in 100% recyclable foil-lined bags featuring a one-way Swiss degassing valve. This expels carbon dioxide while locking out oxygen, preserving aromatic peak for up to 90 days from the roast date stamped on the bag.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mb-5">
            <h3 class="brand-font fw-bold mb-4">You Might Also Enjoy</h3>
            <div class="row g-4">
                @foreach (var rel in related)
                {
                    <div class="col-md-4">
                        <div class="card card-coffee h-100">
                            <div class="card-coffee-img-wrap">
                                <a asp-action="Details" asp-route-id="@rel.Id">
                                    <img src="@rel.ImageUrl" class="card-coffee-img" alt="@rel.Name" style="height: 180px;" />
                                </a>
                                <span class="badge-overlay-category">@rel.Category</span>
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-secondary">@rel.RoastLevel</span>
                                    <span class="fw-bold text-dark">@rel.Price.ToString("C")</span>
                                </div>
                                <h6 class="brand-font fw-bold mb-2">
                                    <a asp-action="Details" asp-route-id="@rel.Id" class="text-dark text-decoration-none">
                                        @rel.Name
                                    </a>
                                </h6>
                                <a asp-action="Details" asp-route-id="@rel.Id" class="btn btn-sm btn-coffee-outline mt-auto w-100">
                                    View Tasting Profile
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
